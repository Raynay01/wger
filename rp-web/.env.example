# Address of the Django API, as seen by the web server
KINUTRI_API_URL=http://127.0.0.1:8100

# OAuth client ID of the Google Cloud project (same value as GOOGLE_CLIENT_ID in Django)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Name shown in the app
NEXT_PUBLIC_APP_NAME=Kinutri

# Shows a username and password form besides Google. Development and tests only.
KINUTRI_DEV_LOGIN=0
