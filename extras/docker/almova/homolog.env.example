# ALMOVA: environment of the staging (homologação) stack. Copy to homolog.env
# (or production.env, with ALMOVA_ENV_FILE=production.env) and fill in the
# empty values. Never commit the filled-in file.

# Secrets: generate fresh ones for each installation (see README.md)
SECRET_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
POSTGRES_PASSWORD=

# Addresses
SITE_URL=http://localhost:8080
WEB_APP_URL=http://localhost:8080
# Keep localhost and web next to the public address: the health check and the
# web app call the server by these names
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Browser pages of other origins that call the API; none needed by ALMOVA
CORS_ALLOWED_ORIGINS=

# Security
DJANGO_DEBUG=False
CARE_PROFESSIONAL_MFA=True
# Professionals log in again this many days after the login (0 is off)
CARE_PROFESSIONAL_LOGIN_DAYS=30
# URL scheme of the ALMOVA app for the login through the browser
APP_AUTH_SCHEME=almova
CLAMAV_HOST=clamav
# Behind TLS in production: X_FORWARDED_PROTO_HEADER_SET=True and SECURE_HSTS_SECONDS=63072000
X_FORWARDED_PROTO_HEADER_SET=False
SECURE_HSTS_SECONDS=0
ACCESS_TOKEN_LIFETIME=10
REFRESH_TOKEN_LIFETIME=2880
AXES_ENABLED=True
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_TIME=30
AXES_HANDLER=axes.handlers.cache.AxesCacheHandler
AXES_LOCKOUT_PARAMETERS=ip_address
AXES_IPWARE_PROXY_COUNT=1
AXES_IPWARE_META_PRECEDENCE_ORDER=HTTP_X_REAL_IP,REMOTE_ADDR
NUMBER_OF_PROXIES=1

# Database
POSTGRES_USER=almova
POSTGRES_DB=almova
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_DATABASE=almova
DJANGO_DB_USER=almova
DJANGO_DB_PASSWORD=${POSTGRES_PASSWORD}
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432
DJANGO_PERFORM_MIGRATIONS=True

# Encrypted backups (docker compose run --rm backup): age public key(s), the
# private key stays off the server. See extras/backup/README.md
BACKUP_AGE_RECIPIENTS=
BACKUP_KEEP_DAYS=30
PGUSER=almova
PGPASSWORD=${POSTGRES_PASSWORD}
PGDATABASE=almova

# PowerSync (offline sync of the mobile app)
PS_DATABASE_URI=postgres://almova:${POSTGRES_PASSWORD}@db:5432/almova
PS_STORAGE_PG_URI=postgres://powersync_storage:${POSTGRES_PASSWORD}@db:5432/almova
PS_PORT=8080
POWERSYNC_URL_PATH=ps

# Files
DJANGO_MEDIA_ROOT=/home/wger/media
DJANGO_PRIVATE_MEDIA_ROOT=/home/wger/private-media
DJANGO_COLLECTSTATIC_ON_STARTUP=True
DJANGO_CLEAR_STATIC_FIRST=False
ALLOW_UPLOAD_VIDEOS=True

# Cache and background tasks
DJANGO_CACHE_BACKEND=django_redis.cache.RedisCache
DJANGO_CACHE_LOCATION=redis://cache:6379/1
DJANGO_CACHE_TIMEOUT=1296000
DJANGO_CACHE_CLIENT_CLASS=django_redis.client.DefaultClient
USE_CELERY=True
CELERY_BROKER=redis://cache:6379/2
CELERY_BACKEND=redis://cache:6379/2
CELERY_WORKER_CONCURRENCY=2

# Exercise and food databases from wger.de (needs access to wger.de)
WGER_INSTANCE=https://wger.de
SYNC_EXERCISES_CELERY=True
SYNC_EXERCISE_IMAGES_CELERY=True
SYNC_EXERCISE_VIDEOS_CELERY=False
SYNC_INGREDIENTS_CELERY=False
CACHE_API_EXERCISES_CELERY=True

# App
WEB_APP_NAME=ALMOVA
TIME_ZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
ALLOW_REGISTRATION=True
ALLOW_GUEST_USERS=False
CAPTCHA_PROVIDER=none
WGER_USE_GUNICORN=True
WGER_PORT=8000
GUNICORN_CMD_ARGS="--workers 3 --threads 2 --worker-class gthread --timeout 240"
LOG_LEVEL_PYTHON=INFO
EXPOSE_PROMETHEUS_METRICS=False
FROM_EMAIL=ALMOVA <nao-responda@example.com>
ENABLE_EMAIL=False

# Push notices (Firebase Cloud Messaging). Off while empty. The key file of the
# service account goes in as a file (see README.md), never as a variable
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Web app: login with username and password only for automated tests, never in production
KINUTRI_DEV_LOGIN=0
