 import 'package:wger/core/material.dart';
 import 'package:wger/features/account/providers/timezone_sync.dart';
@@ -56,7 +57,9 @@ class _HomeTabsScreenState extends ConsumerState<HomeTabsScreen>
       if (!mounted) {
