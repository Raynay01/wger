 /// public. The logs can still be copied for a private report.
 const PUBLIC_ISSUE_REPORTS = bool.fromEnvironment('ALMOVA_PUBLIC_ISSUE_REPORTS');
 
+/// Whether the app imports readings from Health Connect / Apple Health. Off
+/// in the first ALMOVA release: Google Play reviews each health permission
+/// separately. Turning it on also needs the Health Connect entries of the
+/// Android manifest back (health_manifest_test.dart checks both together).
+const HEALTH_CONNECT = false;
+
 /// Maximum length for a pre-filled GitHub issue URL. GitHub starts answering
 /// issues/new with an error page at roughly 7050 characters (measured 2026-07),
 /// so stay well below that.
diff --git a/lib/core/home_tabs_screen.dart b/lib/core/home_tabs_screen.dart
index b29b731..80e3049 100644
--- a/lib/core/home_tabs_screen.dart
