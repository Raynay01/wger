+import 'package:json_annotation/json_annotation.dart';
+
+part 'access_grant.g.dart';
+
+/// Data the user shares with one professional (Django `care.AccessGrant`)
+@JsonSerializable(createToJson: false)
+class AccessGrant {
+  @JsonKey(required: true)
+  final String id;
+
+  @JsonKey(required: true)
+  final String relationship;
+
+  /// E.g. training.schedule, see [sharingScopes]
+  @JsonKey(required: true)
+  final String scope;
+
+  const AccessGrant({required this.id, required this.relationship, required this.scope});
+
+  factory AccessGrant.fromJson(Map<String, dynamic> json) => _$AccessGrantFromJson(json);
+}
+
+/// What can be shared, in the order of the web app
+const sharingScopes = [
+  'training.schedule',
+  'training.adherence',
+  'nutrition.goals',
+  'nutrition.adherence',
+  'physio.pain',
+  'body.measurements',
+  'notes.multidisciplinary',
+];
