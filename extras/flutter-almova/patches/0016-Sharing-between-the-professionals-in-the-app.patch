 import 'package:wger/features/care/models/care_relationship.dart';
 import 'package:wger/features/care/models/data_request.dart';
@@ -44,6 +45,7 @@ class CareRepository {
   static const appointmentPath = 'appointment';
   static const messagePath = 'care-message';
   static const dataRequestPath = 'data-request';
+  static const grantPath = 'access-grant';
 
   final WgerBaseProvider base;
 
@@ -191,4 +193,32 @@ class CareRepository {
   Future<void> requestDeletion() => _postAction(dataRequestPath, {'confirm': true});
 
   Future<void> cancelDataRequest(String id) => _postAction('$dataRequestPath/$id/cancel', {});
+
+  /// What the user shares now (revoked grants are left out by the server)
+  Future<List<AccessGrant>> fetchGrants() async {
+    final data = await base.fetchPaginated(
+      base.makeUrl(grantPath, query: {'limit': API_MAX_PAGE_SIZE}),
+    );
+    return data.map((e) => AccessGrant.fromJson(e as Map<String, dynamic>)).toList();
+  }
+
+  /// Shares [scope] with the professional; the server records the consent
+  Future<AccessGrant> share(String relationshipId, String scope) async {
+    final data = await base.post(
+      {'relationship': relationshipId, 'scope': scope},
+      base.makeUrl(grantPath),
+    );
+    return AccessGrant.fromJson(data);
+  }
+
+  /// Stops sharing: the grant is revoked and kept as evidence
+  Future<void> stopSharing(String grantId) async {
+    final response = await base.client.delete(
+      base.makeUrl('$grantPath/$grantId'),
+      headers: base.getDefaultHeaders(),
+    );
+    if (response.statusCode >= 400) {
+      throw WgerHttpException(response);
+    }
+  }
 }
