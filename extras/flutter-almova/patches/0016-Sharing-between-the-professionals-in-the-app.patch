+  test('sharing: list, share and stop sharing', () async {
+    final sent = <http.Request>[];
+    final repository = CareRepository(
+      WgerBaseProvider(
+        serverUrl: 'https://almova.test',
+        client: MockClient((request) async {
+          sent.add(request);
+          final body = request.method == 'GET'
+              ? {
+                  'count': 1,
+                  'next': null,
+                  'results': [
+                    {'id': 'g1', 'relationship': 'r1', 'scope': 'physio.pain'},
+                  ],
+                }
+              : {'id': 'g2', 'relationship': 'r1', 'scope': 'body.measurements'};
+          return http.Response.bytes(
+            utf8.encode(json.encode(body)),
+            request.method == 'DELETE' ? 204 : 200,
+            headers: {'content-type': 'application/json'},
+          );
+        }),
+      ),
+    );
+
+    expect((await repository.fetchGrants()).single.scope, 'physio.pain');
+    expect((await repository.share('r1', 'body.measurements')).id, 'g2');
+    await repository.stopSharing('g1');
+
+    expect(sent[0].url.path, '/api/v2/access-grant/');
+    expect(sent[1].method, 'POST');
+    expect(json.decode(sent[1].body), {'relationship': 'r1', 'scope': 'body.measurements'});
+    expect(sent[2].method, 'DELETE');
+    expect(sent[2].url.path, '/api/v2/access-grant/g1/');
+  });
 }
