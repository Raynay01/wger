+ * You should have received a copy of the GNU Affero General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:mockito/annotations.dart';
+import 'package:mockito/mockito.dart';
+import 'package:wger/features/care/models/access_grant.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+import 'package:wger/features/care/screens/sharing_screen.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+import 'package:wger/l10n/localizations_delegates.dart';
+
+import 'sharing_screen_test.mocks.dart';
+
+const physio = CareRelationship(
+  id: 'r1',
+  discipline: Discipline.physio,
+  status: 'active',
+  professionalName: 'Paula',
+);
+
+@GenerateMocks([CareRepository])
+void main() {
+  late MockCareRepository repository;
+
+  setUp(() {
+    repository = MockCareRepository();
+    when(repository.fetchMyProfessionals()).thenAnswer((_) async => [physio]);
+    when(repository.fetchGrants()).thenAnswer(
+      (_) async => [const AccessGrant(id: 'g1', relationship: 'r1', scope: 'training.schedule')],
+    );
+  });
+
+  Future<void> render(WidgetTester tester) async {
+    tester.view.physicalSize = const Size(1080, 3000);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [careRepositoryProvider.overrideWithValue(repository)],
+        child: const MaterialApp(
+          locale: Locale('pt', 'BR'),
+          localizationsDelegates: appLocalizationsDelegates,
+          supportedLocales: AppLocalizations.supportedLocales,
+          home: SharingScreen(),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+  }
+
+  SwitchListTile tile(WidgetTester tester, String title) =>
+      tester.widget<SwitchListTile>(find.widgetWithText(SwitchListTile, title));
+
+  testWidgets("the physiotherapist's own area is not offered", (tester) async {
+    await render(tester);
+
+    expect(find.text('Paula'), findsOneWidget);
+    expect(find.text('Fisioterapeuta'), findsOneWidget);
+    expect(find.text('Registros de dor'), findsNothing);
+    expect(find.byType(SwitchListTile), findsNWidgets(6));
+    expect(tile(tester, 'Rotina de treino').value, isTrue);
+    expect(tile(tester, 'Peso e medidas').value, isFalse);
+  });
+
+  testWidgets('turning on shares, turning off stops sharing', (tester) async {
+    when(repository.share('r1', 'body.measurements')).thenAnswer(
+      (_) async => const AccessGrant(id: 'g2', relationship: 'r1', scope: 'body.measurements'),
+    );
+    when(repository.stopSharing('g1')).thenAnswer((_) async {});
+    await render(tester);
+
+    await tester.tap(find.text('Peso e medidas'));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Rotina de treino'));
+    await tester.pumpAndSettle();
+
+    verify(repository.share('r1', 'body.measurements')).called(1);
+    verify(repository.stopSharing('g1')).called(1);
+    expect(tile(tester, 'Peso e medidas').value, isTrue);
+    expect(tile(tester, 'Rotina de treino').value, isFalse);
+  });
+
+  testWidgets('a failed change says so and keeps the switch', (tester) async {
+    when(repository.share(any, any)).thenThrow(Exception('offline'));
+    await render(tester);
+
+    await tester.tap(find.text('Peso e medidas'));
+    await tester.pumpAndSettle();
+
+    expect(find.text('Não foi possível enviar. Tente de novo.'), findsOneWidget);
+    expect(tile(tester, 'Peso e medidas').value, isFalse);
+  });
+
+  testWidgets('what is shared with one professional is not shared with another', (tester) async {
+    when(repository.fetchMyProfessionals()).thenAnswer(
+      (_) async => [
+        physio,
+        const CareRelationship(
+          id: 'r2',
+          discipline: Discipline.nutrition,
+          status: 'active',
+          professionalName: 'Nina',
+        ),
+      ],
+    );
+    await render(tester);
+
+    final schedules = tester
+        .widgetList<SwitchListTile>(find.widgetWithText(SwitchListTile, 'Rotina de treino'))
+        .map((t) => t.value)
+        .toList();
+    expect(schedules, [true, false]);
+  });
+}
