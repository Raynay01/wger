+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:wger/core/widgets/progress_indicator.dart';
+import 'package:wger/features/care/care.dart';
+import 'package:wger/features/care/providers/sharing_notifier.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+
+(String, String) scopeLabel(AppLocalizations i18n, String scope) => switch (scope) {
+  'training.schedule' => (i18n.sharingTrainingSchedule, i18n.sharingTrainingScheduleText),
+  'training.adherence' => (i18n.sharingTrainingAdherence, i18n.sharingTrainingAdherenceText),
+  'nutrition.goals' => (i18n.sharingNutritionGoals, i18n.sharingNutritionGoalsText),
+  'nutrition.adherence' => (i18n.sharingNutritionAdherence, i18n.sharingNutritionAdherenceText),
+  'physio.pain' => (i18n.sharingPhysioPain, i18n.sharingPhysioPainText),
+  'body.measurements' => (i18n.sharingBodyMeasurements, i18n.sharingBodyMeasurementsText),
+  _ => (i18n.sharingNotes, i18n.sharingNotesText),
+};
+
+/// What else each professional may see, besides their own area
+class SharingScreen extends ConsumerWidget {
+  const SharingScreen({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    final sharing = ref.watch(sharingProvider);
+
+    return Scaffold(
+      appBar: AppBar(title: Text(i18n.sharingTitle)),
+      body: switch (sharing) {
+        AsyncValue(:final value?) => ListView(
+          padding: const EdgeInsets.all(8),
+          children: [
+            Padding(padding: const EdgeInsets.all(8), child: Text(i18n.sharingIntro)),
+            for (final professional in value.professionals)
+              Card(
+                child: Column(
+                  children: [
+                    ListTile(
+                      leading: Icon(disciplineIcon(professional.discipline)),
+                      title: Text(
+                        professional.professionalName,
+                        style: Theme.of(context).textTheme.titleLarge,
+                      ),
+                      subtitle: Text(professionLabel(i18n, professional.discipline)),
+                    ),
+                    for (final scope in scopesFor(professional.discipline))
+                      SwitchListTile(
+                        title: Text(scopeLabel(i18n, scope).$1),
+                        subtitle: Text(scopeLabel(i18n, scope).$2),
+                        value: value.grantFor(professional.id, scope) != null,
+                        onChanged: (shared) =>
+                            _toggle(context, ref, professional.id, scope, shared),
+                      ),
+                  ],
+                ),
+              ),
+          ],
+        ),
+        AsyncValue(:final error?) => Center(child: Text(error.toString())),
+        _ => const CenteredProgressIndicator(),
+      },
+    );
+  }
+
+  Future<void> _toggle(
+    BuildContext context,
+    WidgetRef ref,
+    String relationshipId,
+    String scope,
+    bool shared,
+  ) async {
+    final failed = AppLocalizations.of(context).careSendFailed;
+    try {
+      await ref.read(sharingProvider.notifier).setShared(relationshipId, scope, shared);
+    } catch (_) {
+      if (context.mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(failed)));
+      }
+    }
+  }
+}
