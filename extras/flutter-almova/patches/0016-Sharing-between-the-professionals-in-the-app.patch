+
+import 'package:riverpod_annotation/riverpod_annotation.dart';
+import 'package:wger/features/care/models/access_grant.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+
+part 'sharing_notifier.g.dart';
+
+/// A professional already sees their own area, offering it again is noise
+const ownScopes = {
+  Discipline.training: ['training.schedule', 'training.adherence'],
+  Discipline.nutrition: ['nutrition.goals', 'nutrition.adherence'],
+  Discipline.physio: ['physio.pain'],
+};
+
+/// The scopes the user can share with a professional of [discipline]
+List<String> scopesFor(Discipline? discipline) =>
+    sharingScopes.where((s) => !(ownScopes[discipline]?.contains(s) ?? false)).toList();
+
+class SharingState {
+  final List<CareRelationship> professionals;
+  final List<AccessGrant> grants;
+
+  const SharingState({required this.professionals, required this.grants});
+
+  AccessGrant? grantFor(String relationshipId, String scope) =>
+      grants.where((g) => g.relationship == relationshipId && g.scope == scope).firstOrNull;
+}
+
+@riverpod
+class SharingNotifier extends _$SharingNotifier {
+  @override
+  Future<SharingState> build() async {
+    final repository = ref.read(careRepositoryProvider);
+    final (professionals, grants) = await (
+      repository.fetchMyProfessionals(),
+      repository.fetchGrants(),
+    ).wait;
+    return SharingState(professionals: professionals, grants: grants);
+  }
+
+  Future<void> setShared(String relationshipId, String scope, bool shared) async {
+    final current = state.requireValue;
+    final repository = ref.read(careRepositoryProvider);
+    final existing = current.grantFor(relationshipId, scope);
+    if (shared && existing == null) {
+      final grant = await repository.share(relationshipId, scope);
+      state = AsyncData(
+        SharingState(professionals: current.professionals, grants: [...current.grants, grant]),
+      );
+    } else if (!shared && existing != null) {
+      await repository.stopSharing(existing.id);
+      state = AsyncData(
+        SharingState(
+          professionals: current.professionals,
+          grants: [...current.grants.where((g) => g.id != existing.id)],
+        ),
+      );
+    }
+  }
+}
