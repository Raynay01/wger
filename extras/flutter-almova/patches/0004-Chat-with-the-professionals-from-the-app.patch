+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:mockito/annotations.dart';
+import 'package:mockito/mockito.dart';
+import 'package:wger/features/care/models/message.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+import 'package:wger/features/care/providers/conversation_notifier.dart';
+
+import 'conversation_notifier_test.mocks.dart';
+
+Message message(String id, {bool mine = false, DateTime? readAt}) => Message(
+  id: id,
+  relationship: 'r1',
+  mine: mine,
+  text: 'oi',
+  created: DateTime.utc(2026, 11, 16, 12),
+  readAt: readAt,
+);
+
+@GenerateMocks([CareRepository])
+void main() {
+  late MockCareRepository repository;
+  late ProviderContainer container;
+
+  setUp(() {
+    repository = MockCareRepository();
+    container = ProviderContainer(
+      overrides: [careRepositoryProvider.overrideWithValue(repository)],
+    );
+    addTearDown(container.dispose);
+    when(repository.markRead(any)).thenAnswer((_) async {});
+  });
+
+  test("opening the conversation marks the professional's messages as read", () async {
+    when(repository.fetchMessages('r1')).thenAnswer((_) async => [message('m1')]);
+
+    await container.read(conversationProvider('r1').future);
+
+    verify(repository.markRead('r1')).called(1);
+  });
+
+  test('nothing to mark when all was read or sent by the user', () async {
+    when(repository.fetchMessages('r1')).thenAnswer(
+      (_) async => [message('m1', mine: true), message('m2', readAt: DateTime.utc(2026))],
+    );
+
+    await container.read(conversationProvider('r1').future);
+
+    verifyNever(repository.markRead(any));
+  });
+
+  test('a sent message is appended', () async {
+    when(repository.fetchMessages('r1')).thenAnswer((_) async => [message('m1')]);
+    when(repository.sendText('r1', 'tudo bem')).thenAnswer((_) async => message('m2', mine: true));
+
+    await container.read(conversationProvider('r1').future);
+    await container.read(conversationProvider('r1').notifier).send('  tudo bem ');
+
+    expect(container.read(conversationProvider('r1')).value!.map((m) => m.id), ['m1', 'm2']);
+  });
+}
