+
+Message _$MessageFromJson(Map<String, dynamic> json) {
+  $checkKeys(
+    json,
+    requiredKeys: const ['id', 'relationship', 'mine', 'created'],
+  );
+  return Message(
+    id: json['id'] as String,
+    relationship: json['relationship'] as String,
+    mine: json['mine'] as bool,
+    senderName: json['sender_name'] as String?,
+    text: json['text'] as String? ?? '',
+    attachmentKind: $enumDecodeNullable(
+      _$AttachmentKindEnumMap,
+      json['attachment_kind'],
+      unknownValue: JsonKey.nullForUndefinedEnumValue,
+    ),
+    created: utcIso8601ToLocalDate(json['created'] as String),
+    readAt: utcIso8601ToLocalDateNull(json['read_at'] as String?),
+  );
+}
+
+const _$AttachmentKindEnumMap = {
+  AttachmentKind.image: 'image',
+  AttachmentKind.video: 'video',
+};
