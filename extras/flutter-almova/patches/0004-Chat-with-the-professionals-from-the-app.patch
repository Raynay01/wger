+import 'package:wger/l10n/generated/app_localizations.dart';
+
+/// The chat with the professional of a follow-up
+class ConversationScreen extends ConsumerWidget {
+  final CareRelationship relationship;
+
+  const ConversationScreen({super.key, required this.relationship});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    final conversation = ref.watch(conversationProvider(relationship.id));
+
+    return Scaffold(
+      appBar: AppBar(title: Text(relationship.professionalName)),
+      body: Column(
+        children: [
+          Expanded(
+            child: switch (conversation) {
+              AsyncValue(:final value?) when value.isEmpty => Center(
+                child: Text(i18n.careNoMessages),
+              ),
+              AsyncValue(:final value?) => ListView.builder(
+                reverse: true,
+                padding: const EdgeInsets.all(8),
+                itemCount: value.length,
+                itemBuilder: (context, index) => MessageBubble(value[value.length - 1 - index]),
+              ),
+              AsyncValue(:final error?) => Center(child: Text(error.toString())),
+              _ => const CenteredProgressIndicator(),
+            },
+          ),
+          if (relationship.isOpen) MessageComposer(relationshipId: relationship.id),
+        ],
+      ),
+    );
+  }
+}
+
+class MessageBubble extends StatelessWidget {
+  final Message message;
+
+  const MessageBubble(this.message, {super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final i18n = AppLocalizations.of(context);
+    final colors = Theme.of(context).colorScheme;
+    final time = DateFormat.Hm(Localizations.localeOf(context).toString()).format(message.created);
+
+    return Align(
+      alignment: message.mine ? Alignment.centerRight : Alignment.centerLeft,
+      child: ConstrainedBox(
+        constraints: BoxConstraints(maxWidth: MediaQuery.sizeOf(context).width * 0.8),
+        child: Card(
+          color: message.mine ? colors.primaryContainer : colors.surfaceContainerHighest,
+          child: Padding(
+            padding: const EdgeInsets.all(10),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                if (message.attachmentKind == AttachmentKind.image) _Photo(message.id),
+                if (message.attachmentKind == AttachmentKind.video)
+                  Row(
+                    mainAxisSize: MainAxisSize.min,
+                    children: [
+                      const Icon(Icons.videocam),
+                      const SizedBox(width: 4),
+                      Text(i18n.careVideo),
+                    ],
+                  ),
+                if (message.text.isNotEmpty) Text(message.text),
+                const SizedBox(height: 4),
+                Text(time, style: Theme.of(context).textTheme.labelSmall),
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class _Photo extends ConsumerWidget {
+  final String messageId;
+
+  const _Photo(this.messageId);
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final file = ref.watch(messageAttachmentProvider(messageId));
+    return ConstrainedBox(
+      constraints: const BoxConstraints(maxHeight: 240),
+      child: switch (file) {
+        AsyncValue(:final value?) => Image.memory(value, fit: BoxFit.contain),
+        AsyncValue(:final error?) => ImageError('Network error', errorMessage: error.toString()),
+        _ => const SizedBox(height: 120, child: CenteredProgressIndicator()),
+      },
+    );
+  }
+}
+
+class MessageComposer extends ConsumerStatefulWidget {
+  final String relationshipId;
+
+  const MessageComposer({super.key, required this.relationshipId});
+
+  @override
+  ConsumerState<MessageComposer> createState() => _MessageComposerState();
+}
+
+class _MessageComposerState extends ConsumerState<MessageComposer> {
+  // A controller: the field is cleared after sending
+  late final TextEditingController _text;
+  bool _sending = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _text = TextEditingController();
+  }
+
+  @override
+  void dispose() {
+    _text.dispose();
+    super.dispose();
+  }
+
+  Future<void> _send() async {
+    final text = _text.text.trim();
+    if (text.isEmpty || _sending) {
+      return;
+    }
+    setState(() => _sending = true);
+    try {
+      await ref.read(conversationProvider(widget.relationshipId).notifier).send(text);
+      _text.clear();
+    } catch (_) {
+      if (mounted) {
+        ScaffoldMessenger.of(
+          context,
+        ).showSnackBar(SnackBar(content: Text(AppLocalizations.of(context).careSendFailed)));
+      }
+    } finally {
+      if (mounted) {
+        setState(() => _sending = false);
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final i18n = AppLocalizations.of(context);
+    return SafeArea(
+      child: Padding(
+        padding: const EdgeInsets.fromLTRB(8, 0, 8, 8),
+        child: Row(
+          children: [
+            Expanded(
+              child: TextField(
+                controller: _text,
+                minLines: 1,
+                maxLines: 5,
+                textCapitalization: TextCapitalization.sentences,
+                decoration: InputDecoration(hintText: i18n.careWriteMessage),
+              ),
+            ),
+            IconButton(
+              tooltip: i18n.careSend,
+              onPressed: _sending ? null : _send,
+              icon: const Icon(Icons.send),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
