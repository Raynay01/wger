+import 'package:json_annotation/json_annotation.dart';
+import 'package:wger/core/json.dart';
+
+part 'message.g.dart';
+
+enum AttachmentKind { image, video }
+
+/// A message between the user and a professional (Django `care.Message`)
+@JsonSerializable(createToJson: false)
+class Message {
+  @JsonKey(required: true)
+  final String id;
+
+  @JsonKey(required: true)
+  final String relationship;
+
+  /// Sent by the user
+  @JsonKey(required: true)
+  final bool mine;
+
+  @JsonKey(name: 'sender_name')
+  final String? senderName;
+
+  @JsonKey(defaultValue: '')
+  final String text;
+
+  @JsonKey(name: 'attachment_kind', unknownEnumValue: JsonKey.nullForUndefinedEnumValue)
+  final AttachmentKind? attachmentKind;
+
+  @JsonKey(required: true, fromJson: utcIso8601ToLocalDate)
+  final DateTime created;
+
+  @JsonKey(name: 'read_at', fromJson: utcIso8601ToLocalDateNull)
+  final DateTime? readAt;
+
+  const Message({
+    required this.id,
+    required this.relationship,
+    required this.mine,
+    this.senderName,
+    required this.text,
+    this.attachmentKind,
+    required this.created,
+    this.readAt,
+  });
+
+  factory Message.fromJson(Map<String, dynamic> json) => _$MessageFromJson(json);
+}
