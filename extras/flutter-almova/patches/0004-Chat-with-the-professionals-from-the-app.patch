+
+  /// The conversation of a follow-up, oldest first
+  Future<List<Message>> fetchMessages(String relationshipId) async {
+    final url = base.makeUrl(
+      messagePath,
+      query: {'relationship': relationshipId, 'ordering': 'created', 'limit': API_MAX_PAGE_SIZE},
+    );
+    final data = await base.fetchPaginated(url);
+    return data.map((e) => Message.fromJson(e as Map<String, dynamic>)).toList();
+  }
+
+  Future<Message> sendText(String relationshipId, String text) async {
+    final response = await base.client.post(
+      base.makeUrl(messagePath),
+      headers: base.getDefaultHeaders(),
+      body: json.encode({'relationship': relationshipId, 'text': text}),
+    );
+    if (response.statusCode >= 400) {
+      throw WgerHttpException(response);
+    }
+    // DRF sends no charset, so decode the bytes as UTF-8 (accents)
+    return Message.fromJson(json.decode(utf8.decode(response.bodyBytes)) as Map<String, dynamic>);
+  }
+
+  /// Marks what the professional sent as read
+  Future<void> markRead(String relationshipId) async {
+    final response = await base.client.post(
+      base.makeUrl(messagePath, objectMethod: 'read'),
+      headers: base.getDefaultHeaders(),
+      body: json.encode({'relationship': relationshipId}),
+    );
+    if (response.statusCode >= 400) {
+      throw WgerHttpException(response);
+    }
+  }
+
+  /// The photo or video of a message; only the two people of the follow-up get it
+  Future<Uint8List> fetchAttachment(String messageId) async {
+    final response = await base.client.get(
+      base.makeUrl('$messagePath/$messageId/attachment'),
+      headers: {HttpHeaders.userAgentHeader: base.getAppNameHeaderValue()},
+    );
+    if (response.statusCode >= 400) {
+      throw WgerHttpException(response);
+    }
+    return response.bodyBytes;
+  }
 }
