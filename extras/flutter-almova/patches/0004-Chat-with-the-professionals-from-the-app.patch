+import 'package:wger/l10n/localizations_delegates.dart';
+
+import 'conversation_screen_test.mocks.dart';
+
+const relationship = CareRelationship(
+  id: 'r1',
+  discipline: Discipline.training,
+  status: 'active',
+  professionalName: 'Bruno',
+);
+
+@GenerateMocks([CareRepository])
+void main() {
+  late MockCareRepository repository;
+
+  setUp(() {
+    repository = MockCareRepository();
+    when(repository.markRead(any)).thenAnswer((_) async {});
+  });
+
+  Widget render(CareRelationship relationship) => ProviderScope(
+    overrides: [careRepositoryProvider.overrideWithValue(repository)],
+    child: MaterialApp(
+      locale: const Locale('pt', 'BR'),
+      localizationsDelegates: appLocalizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      home: ConversationScreen(relationship: relationship),
+    ),
+  );
+
+  testWidgets('shows the messages and sends a new one', (tester) async {
+    when(repository.fetchMessages('r1')).thenAnswer(
+      (_) async => [
+        Message(
+          id: 'm1',
+          relationship: 'r1',
+          mine: false,
+          text: 'Como foi o treino?',
+          created: DateTime(2026, 11, 16, 9, 5),
+        ),
+      ],
+    );
+    when(repository.sendText('r1', 'Foi ótimo')).thenAnswer(
+      (_) async => Message(
+        id: 'm2',
+        relationship: 'r1',
+        mine: true,
+        text: 'Foi ótimo',
+        created: DateTime(2026, 11, 16, 9, 7),
+      ),
+    );
+
+    await tester.pumpWidget(render(relationship));
+    await tester.pumpAndSettle();
+
+    expect(find.text('Bruno'), findsOneWidget);
+    expect(find.text('Como foi o treino?'), findsOneWidget);
+    expect(find.text('09:05'), findsOneWidget);
+
+    await tester.enterText(find.byType(TextField), 'Foi ótimo');
+    await tester.tap(find.byTooltip('Enviar'));
+    await tester.pumpAndSettle();
+
+    expect(find.text('Foi ótimo'), findsOneWidget);
+    expect(tester.widget<TextField>(find.byType(TextField)).controller!.text, isEmpty);
+  });
+
+  testWidgets('an ended follow-up keeps the history but has no field', (tester) async {
+    when(repository.fetchMessages('r1')).thenAnswer((_) async => []);
+
+    await tester.pumpWidget(
+      render(
+        const CareRelationship(
+          id: 'r1',
+          discipline: Discipline.training,
+          status: 'ended',
+          professionalName: 'Bruno',
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+
+    expect(find.text('Nenhuma mensagem ainda'), findsOneWidget);
+    expect(find.byType(TextField), findsNothing);
+  });
+
+  testWidgets('a failed send keeps the text and says so', (tester) async {
+    when(repository.fetchMessages('r1')).thenAnswer((_) async => []);
+    when(repository.sendText(any, any)).thenThrow(Exception('offline'));
+
+    await tester.pumpWidget(render(relationship));
+    await tester.pumpAndSettle();
+    await tester.enterText(find.byType(TextField), 'Oi');
+    await tester.tap(find.byTooltip('Enviar'));
+    await tester.pumpAndSettle();
+
+    expect(find.text('Não foi possível enviar. Tente de novo.'), findsOneWidget);
+    expect(tester.widget<TextField>(find.byType(TextField)).controller!.text, 'Oi');
+  });
+}
