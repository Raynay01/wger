+import 'dart:async';
+import 'dart:typed_data';
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:logging/logging.dart';
+import 'package:riverpod_annotation/riverpod_annotation.dart';
+import 'package:wger/features/care/models/message.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+
+part 'conversation_notifier.g.dart';
+
+final _logger = Logger('ConversationNotifier');
+
+/// The messages with the professional of a follow-up, oldest first
+@riverpod
+class ConversationNotifier extends _$ConversationNotifier {
+  @override
+  Future<List<Message>> build(String relationshipId) async {
+    final repository = ref.read(careRepositoryProvider);
+    final messages = await repository.fetchMessages(relationshipId);
+    if (messages.any((m) => !m.mine && m.readAt == null)) {
+      unawaited(
+        repository
+            .markRead(relationshipId)
+            .catchError((Object e) => _logger.warning('Could not mark the messages as read', e)),
+      );
+    }
+    return messages;
+  }
+
+  /// Sends a text and appends the stored message
+  Future<void> send(String text) async {
+    final sent = await ref.read(careRepositoryProvider).sendText(relationshipId, text.trim());
+    state = AsyncData([...?state.value, sent]);
+  }
+}
+
+/// How long a downloaded attachment stays in memory after the last viewer
+const attachmentCacheTime = Duration(minutes: 5);
+
+/// The photo of a message, downloaded with the login
+final messageAttachmentProvider = FutureProvider.autoDispose.family<Uint8List, String>((
+  ref,
+  messageId,
+) {
+  final link = ref.keepAlive();
+  Timer? timer;
+  ref.onCancel(() => timer = Timer(attachmentCacheTime, link.close));
+  ref.onResume(() => timer?.cancel());
+  ref.onDispose(() => timer?.cancel());
+  return ref.read(careRepositoryProvider).fetchAttachment(messageId);
+});
