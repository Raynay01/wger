+import 'package:json_annotation/json_annotation.dart';
+import 'package:wger/core/json.dart';
+
+part 'data_request.g.dart';
+
+/// A request about the user's data (Django `care.DataRequest`)
+@JsonSerializable(createToJson: false)
+class DataRequest {
+  @JsonKey(required: true)
+  final String id;
+
+  /// export or deletion
+  @JsonKey(required: true)
+  final String kind;
+
+  /// pending, done, cancelled or rejected
+  @JsonKey(required: true)
+  final String status;
+
+  @JsonKey(required: true, fromJson: utcIso8601ToLocalDate)
+  final DateTime created;
+
+  @JsonKey(defaultValue: '')
+  final String notes;
+
+  const DataRequest({
+    required this.id,
+    required this.kind,
+    required this.status,
+    required this.created,
+    this.notes = '',
+  });
+
+  bool get isPendingDeletion => kind == 'deletion' && status == 'pending';
+
+  factory DataRequest.fromJson(Map<String, dynamic> json) => _$DataRequestFromJson(json);
+}
