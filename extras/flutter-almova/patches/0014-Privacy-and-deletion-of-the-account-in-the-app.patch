+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:mockito/annotations.dart';
+import 'package:mockito/mockito.dart';
+import 'package:wger/core/network/network_provider.dart';
+import 'package:wger/features/care/models/data_request.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+import 'package:wger/features/care/screens/privacy_screen.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+import 'package:wger/l10n/localizations_delegates.dart';
+
+import 'privacy_screen_test.mocks.dart';
+
+final pending = DataRequest(
+  id: 'd2',
+  kind: 'deletion',
+  status: 'pending',
+  created: DateTime(2026, 11, 16, 10, 30),
+);
+
+@GenerateMocks([CareRepository])
+void main() {
+  late MockCareRepository repository;
+
+  setUp(() {
+    repository = MockCareRepository();
+    when(repository.fetchMyProfessionals()).thenAnswer((_) async => []);
+    when(repository.fetchInvitations()).thenAnswer((_) async => []);
+  });
+
+  Future<void> render(WidgetTester tester) async {
+    tester.view.physicalSize = const Size(1080, 3000);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [
+          careRepositoryProvider.overrideWithValue(repository),
+          networkStatusProvider.overrideWithValue(true),
+        ],
+        child: const MaterialApp(
+          locale: Locale('pt', 'BR'),
+          localizationsDelegates: appLocalizationsDelegates,
+          supportedLocales: AppLocalizations.supportedLocales,
+          home: PrivacyScreen(),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+  }
+
+  FilledButton requestButton(WidgetTester tester) =>
+      tester.widget<FilledButton>(find.widgetWithText(FilledButton, 'Pedir a exclusão da conta'));
+
+  testWidgets('asks for the deletion only after typing EXCLUIR', (tester) async {
+    var requests = <DataRequest>[];
+    when(repository.fetchDataRequests()).thenAnswer((_) async => requests);
+    when(repository.requestDeletion()).thenAnswer((_) async => requests = [pending]);
+    await render(tester);
+
+    expect(find.text('Excluir minha conta'), findsOneWidget);
+    expect(find.textContaining('todos os acompanhamentos são encerrados'), findsOneWidget);
+    expect(requestButton(tester).onPressed, isNull);
+
+    await tester.enterText(find.byType(TextField), 'excluir conta');
+    await tester.pump();
+    expect(requestButton(tester).onPressed, isNull);
+
+    await tester.enterText(find.byType(TextField), ' excluir ');
+    await tester.pump();
+    await tester.tap(find.text('Pedir a exclusão da conta'));
+    await tester.pumpAndSettle();
+
+    verify(repository.requestDeletion()).called(1);
+    expect(
+      find.text('Pedido de exclusão registrado. Seus acompanhamentos foram encerrados.'),
+      findsOneWidget,
+    );
+    expect(find.textContaining('está em análise'), findsOneWidget);
+    expect(find.text('Exclusão da conta · 16/11/2026 10:30'), findsOneWidget);
+    expect(find.text('Em análise'), findsOneWidget);
+  });
+
+  testWidgets('a pending deletion can be withdrawn', (tester) async {
+    var requests = [pending];
+    when(repository.fetchDataRequests()).thenAnswer((_) async => requests);
+    when(repository.cancelDataRequest('d2')).thenAnswer((_) async {
+      requests = [
+        DataRequest(id: 'd2', kind: 'deletion', status: 'cancelled', created: pending.created),
+      ];
+    });
+    await render(tester);
+
+    expect(find.byType(TextField), findsNothing);
+    await tester.tap(find.text('Desistir da exclusão'));
+    await tester.pumpAndSettle();
+
+    verify(repository.cancelDataRequest('d2')).called(1);
+    expect(find.text('Cancelado'), findsOneWidget);
+    expect(find.byType(TextField), findsOneWidget);
+  });
+}
