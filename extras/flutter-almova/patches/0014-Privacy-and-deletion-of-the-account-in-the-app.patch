       expect(sent[1].url.path, '/api/v2/care-relationship/r8/decline/');
     });
   });
+
+  group('data requests', () {
+    late List<http.Request> sent;
+
+    CareRepository answeringRequests(String body) {
+      sent = [];
+      return CareRepository(
+        WgerBaseProvider(
+          serverUrl: 'https://almova.test',
+          client: MockClient((request) async {
+            sent.add(request);
+            return http.Response.bytes(
+              utf8.encode(body),
+              200,
+              headers: {'content-type': 'application/json'},
+            );
+          }),
+        ),
+      );
+    }
+
+    test('the requests of the user, newest first', () async {
+      final repository = answeringRequests(
+        json.encode({
+          'count': 2,
+          'next': null,
+          'results': [
+            {
+              'id': 'd1',
+              'kind': 'export',
+              'status': 'done',
+              'created': '2026-11-01T10:00:00Z',
+              'notes': '',
+            },
+            {
+              'id': 'd2',
+              'kind': 'deletion',
+              'status': 'pending',
+              'created': '2026-11-16T10:00:00Z',
+              'notes': '',
+            },
+          ],
+        }),
+      );
+
+      final requests = await repository.fetchDataRequests();
+
+      expect(requests.map((r) => r.id), ['d2', 'd1']);
+      expect(requests.first.isPendingDeletion, isTrue);
+      expect(sent.single.url.path, '/api/v2/data-request/');
+    });
+
+    test('asking for the deletion confirms it, withdrawing cancels it', () async {
+      final repository = answeringRequests('{}');
+
+      await repository.requestDeletion();
+      await repository.cancelDataRequest('d2');
+
+      expect(sent[0].method, 'POST');
+      expect(sent[0].url.path, '/api/v2/data-request/');
+      expect(json.decode(sent[0].body), {'confirm': true});
+      expect(sent[1].url.path, '/api/v2/data-request/d2/cancel/');
+    });
+  });
 }
