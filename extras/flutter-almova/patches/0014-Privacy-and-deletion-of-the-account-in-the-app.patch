+part 'data_requests_notifier.g.dart';
+
+/// The user's requests about their data (LGPD), newest first
+@riverpod
+class DataRequestsNotifier extends _$DataRequestsNotifier {
+  @override
+  Future<List<DataRequest>> build() => ref.read(careRepositoryProvider).fetchDataRequests();
+
+  Future<void> requestDeletion() async {
+    await ref.read(careRepositoryProvider).requestDeletion();
+    // The follow-ups ended
+    ref.invalidate(careOverviewProvider);
+    ref.invalidateSelf();
+    await future;
+  }
+
+  Future<void> cancel(String id) async {
+    await ref.read(careRepositoryProvider).cancelDataRequest(id);
+    ref.invalidateSelf();
+    await future;
+  }
+}
