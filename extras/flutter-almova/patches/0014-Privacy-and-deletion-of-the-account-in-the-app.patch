+ */
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:intl/intl.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:wger/core/misc.dart';
+import 'package:wger/core/network/wger_base.dart';
+import 'package:wger/core/widgets/progress_indicator.dart';
+import 'package:wger/features/care/models/data_request.dart';
+import 'package:wger/features/care/providers/data_requests_notifier.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+
+/// What the user typed to confirm the deletion of the account
+const deletionConfirmationWord = 'EXCLUIR';
+
+/// LGPD: download the data (on the website) and ask for the deletion of the
+/// account, as stores require from apps with accounts
+class PrivacyScreen extends ConsumerWidget {
+  static const routeName = '/privacy';
+
+  const PrivacyScreen({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    final requests = ref.watch(dataRequestsProvider);
+    final serverUrl = ref.watch(wgerBaseProvider).serverUrl;
+
+    return Scaffold(
+      appBar: AppBar(title: Text(i18n.privacyTitle)),
+      body: ListView(
+        padding: const EdgeInsets.all(16),
+        children: [
+          Text(i18n.privacyIntro),
+          const SizedBox(height: 16),
+          Card(
+            child: Padding(
+              padding: const EdgeInsets.all(16),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Text(i18n.privacyDownloadTitle, style: Theme.of(context).textTheme.titleLarge),
+                  const SizedBox(height: 8),
+                  Text(i18n.privacyDownloadText),
+                  const SizedBox(height: 8),
+                  if (serverUrl != null)
+                    OutlinedButton.icon(
+                      icon: const Icon(Icons.open_in_new),
+                      label: Text(i18n.privacyDownloadOnWebsite),
+                      onPressed: () => launchURL('$serverUrl/app/privacidade', context),
+                    ),
+                ],
+              ),
+            ),
+          ),
+          switch (requests) {
+            AsyncValue(:final value?) => _Deletion(requests: value),
+            AsyncValue(:final error?) => Text(error.toString()),
+            _ => const CenteredProgressIndicator(),
+          },
+        ],
+      ),
+    );
+  }
+}
+
+class _Deletion extends ConsumerStatefulWidget {
+  final List<DataRequest> requests;
+
+  const _Deletion({required this.requests});
+
+  @override
+  ConsumerState<_Deletion> createState() => _DeletionState();
+}
+
+class _DeletionState extends ConsumerState<_Deletion> {
+  String _confirmation = '';
+  bool _busy = false;
+
+  Future<void> _run(Future<void> Function() action, String done) async {
+    final messenger = ScaffoldMessenger.of(context);
+    final failed = AppLocalizations.of(context).careSendFailed;
+    setState(() => _busy = true);
+    try {
+      await action();
+      messenger
+        ..hideCurrentSnackBar()
+        ..showSnackBar(SnackBar(content: Text(done)));
+    } catch (_) {
+      messenger
+        ..hideCurrentSnackBar()
+        ..showSnackBar(SnackBar(content: Text(failed)));
+    } finally {
+      if (mounted) {
+        setState(() => _busy = false);
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final i18n = AppLocalizations.of(context);
+    final locale = Localizations.localeOf(context).toString();
+    String when(DateTime d) => DateFormat.yMd(locale).add_Hm().format(d);
+    final pending = widget.requests.where((r) => r.isPendingDeletion).firstOrNull;
+    final notifier = ref.read(dataRequestsProvider.notifier);
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Card(
+          child: Padding(
+            padding: const EdgeInsets.all(16),
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(i18n.privacyDeleteTitle, style: Theme.of(context).textTheme.titleLarge),
+                const SizedBox(height: 8),
+                if (pending != null) ...[
+                  Text(i18n.privacyDeletionPending(when(pending.created))),
+                  const SizedBox(height: 8),
+                  OutlinedButton(
+                    onPressed: _busy
+                        ? null
+                        : () => _run(
+                            () => notifier.cancel(pending.id),
+                            i18n.privacyDeletionCancelled,
+                          ),
+                    child: Text(i18n.privacyCancelDeletion),
+                  ),
+                ] else ...[
+                  Text(i18n.privacyWhatHappens),
+                  Text('• ${i18n.privacyDeletionNow}'),
+                  Text('• ${i18n.privacyDeletionLater}'),
+                  Text('• ${i18n.privacyDeletionCopyFirst}'),
+                  TextField(
+                    autocorrect: false,
+                    decoration: InputDecoration(labelText: i18n.privacyTypeToConfirm),
+                    onChanged: (v) => setState(() => _confirmation = v),
+                  ),
+                  const SizedBox(height: 8),
+                  FilledButton(
+                    style: FilledButton.styleFrom(
+                      backgroundColor: Theme.of(context).colorScheme.error,
+                      foregroundColor: Theme.of(context).colorScheme.onError,
+                    ),
+                    onPressed:
+                        _busy || _confirmation.trim().toUpperCase() != deletionConfirmationWord
+                        ? null
+                        : () => _run(notifier.requestDeletion, i18n.privacyDeletionRequested),
+                    child: Text(i18n.privacyRequestDeletion),
+                  ),
+                ],
+              ],
+            ),
+          ),
+        ),
+        if (widget.requests.isNotEmpty)
+          Card(
+            child: Column(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                ListTile(
+                  title: Text(
+                    i18n.privacyYourRequests,
+                    style: Theme.of(context).textTheme.titleLarge,
+                  ),
+                ),
+                for (final r in widget.requests)
+                  ListTile(
+                    title: Text(
+                      '${r.kind == 'deletion' ? i18n.privacyKindDeletion : i18n.privacyKindExport}'
+                      ' · ${when(r.created)}',
+                    ),
+                    subtitle: r.notes.isEmpty ? null : Text(r.notes),
+                    trailing: Text(switch (r.status) {
+                      'pending' => i18n.privacyStatusPending,
+                      'done' => i18n.privacyStatusDone,
+                      'cancelled' => i18n.privacyStatusCancelled,
+                      _ => i18n.privacyStatusRejected,
+                    }),
+                  ),
+              ],
+            ),
+          ),
+      ],
+    );
+  }
+}
