+Map<String, dynamic> _$AppointmentToJson(Appointment instance) => <String, dynamic>{
+  'id': instance.id,
+  'relationship': instance.relationship,
+  'kind': instance.kind,
+  'start': instance.start.toIso8601String(),
+  'duration_minutes': instance.durationMinutes,
+  'location': instance.location,
+  'status': instance.status,
+  'discipline': _$DisciplineEnumMap[instance.discipline],
+  'professional': instance.professional,
+};
+
+const _$DisciplineEnumMap = {
+  Discipline.training: 'training',
+  Discipline.physio: 'physio',
+  Discipline.nutrition: 'nutrition',
+};
