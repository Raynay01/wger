+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:wger/core/network/base_provider.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+
+Map<String, dynamic> relationship(String id, String status, {String discipline = 'training'}) => {
+  'id': id,
+  'discipline': discipline,
+  'status': status,
+  'professional_name': 'Prof $id',
+  'organization_name': 'Clínica',
+};
+
+Map<String, dynamic> appointment(String id, String start) => {
+  'id': id,
+  'relationship': 'r1',
+  'kind': 'session',
+  'start': start,
+  'duration_minutes': 50,
+  'location': '',
+  'status': 'scheduled',
+  'discipline': 'physio',
+  'professional': 'Paula',
+  'patient': 'Ana',
+};
+
+void main() {
+  late List<Uri> requests;
+
+  CareRepository answering(List<Map<String, dynamic>> results) {
+    requests = [];
+    return CareRepository(
+      WgerBaseProvider(
+        serverUrl: 'https://almova.test',
+        client: MockClient((request) async {
+          requests.add(request.url);
+          return http.Response.bytes(
+            utf8.encode(json.encode({'count': results.length, 'next': null, 'results': results})),
+            200,
+          );
+        }),
+      ),
+    );
+  }
+
+  test('my professionals: as patient, only the open follow-ups', () async {
+    final repository = answering([
+      relationship('r1', 'active'),
+      relationship('r2', 'paused', discipline: 'nutrition'),
+      relationship('r3', 'ended'),
+      relationship('r4', 'invited'),
+    ]);
+
+    final professionals = await repository.fetchMyProfessionals();
+
+    expect(professionals.map((r) => r.id), ['r1', 'r2']);
+    expect(professionals[1].discipline, Discipline.nutrition);
+    expect(requests.single.path, '/api/v2/care-relationship/');
+    expect(requests.single.queryParameters['role'], 'patient');
+  });
+
+  test('upcoming appointments: scheduled, from the given instant, earliest first', () async {
+    final repository = answering([
+      appointment('a2', '2026-11-20T09:00:00-03:00'),
+      appointment('a1', '2026-11-18T14:00:00-03:00'),
+    ]);
+
+    final upcoming = await repository.fetchUpcomingAppointments(DateTime.utc(2026, 11, 16, 12));
+
+    expect(upcoming.map((a) => a.id), ['a1', 'a2']);
+    expect(upcoming.first.start.isAtSameMomentAs(DateTime.utc(2026, 11, 18, 17)), isTrue);
+    final query = requests.single.queryParameters;
+    expect(requests.single.path, '/api/v2/appointment/');
+    expect(query['status'], 'scheduled');
+    expect(
+      DateTime.parse(query['start__gte']!).isAtSameMomentAs(DateTime.utc(2026, 11, 16, 12)),
+      isTrue,
+    );
+  });
+}
