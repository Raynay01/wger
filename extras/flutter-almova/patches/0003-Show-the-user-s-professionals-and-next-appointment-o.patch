+import 'package:json_annotation/json_annotation.dart';
+
+part 'care_relationship.g.dart';
+
+/// The area of a professional (Django `care.Discipline`)
+enum Discipline { training, physio, nutrition }
+
+/// A follow-up between a professional and the user (Django `CareRelationship`)
+@JsonSerializable()
+class CareRelationship {
+  @JsonKey(required: true)
+  final String id;
+
+  @JsonKey(required: true, unknownEnumValue: JsonKey.nullForUndefinedEnumValue)
+  final Discipline? discipline;
+
+  /// invited, active, paused or ended
+  @JsonKey(required: true)
+  final String status;
+
+  @JsonKey(required: true, name: 'professional_name')
+  final String professionalName;
+
+  @JsonKey(name: 'organization_name')
+  final String? organizationName;
+
+  const CareRelationship({
+    required this.id,
+    required this.discipline,
+    required this.status,
+    required this.professionalName,
+    this.organizationName,
+  });
+
+  /// Active or paused: the professional still follows the user
+  bool get isOpen => status == 'active' || status == 'paused';
+
+  factory CareRelationship.fromJson(Map<String, dynamic> json) => _$CareRelationshipFromJson(json);
+
+  Map<String, dynamic> toJson() => _$CareRelationshipToJson(this);
+}
