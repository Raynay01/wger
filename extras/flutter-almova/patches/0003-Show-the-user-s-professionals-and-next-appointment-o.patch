+import 'package:riverpod_annotation/riverpod_annotation.dart';
+import 'package:wger/core/network/network_provider.dart';
+import 'package:wger/features/care/models/appointment.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+
+part 'care_overview.g.dart';
+
+/// The user's professionals and the next appointment with one of them
+class CareOverview {
+  final List<CareRelationship> professionals;
+  final Appointment? nextAppointment;
+
+  const CareOverview({required this.professionals, this.nextAppointment});
+}
+
+/// Null while offline: the follow-up is REST only
+@riverpod
+Future<CareOverview?> careOverview(Ref ref) async {
+  if (!ref.watch(networkStatusProvider)) {
+    return null;
+  }
+  final repository = ref.read(careRepositoryProvider);
+  final professionals = await repository.fetchMyProfessionals();
+  if (professionals.isEmpty) {
+    return const CareOverview(professionals: []);
+  }
+
+  // The user may be a professional too: only appointments as a patient
+  final mine = professionals.map((r) => r.id).toSet();
+  final upcoming = await repository.fetchUpcomingAppointments(DateTime.now());
+  return CareOverview(
+    professionals: professionals,
+    nextAppointment: upcoming.where((a) => mine.contains(a.relationship)).firstOrNull,
+  );
+}
