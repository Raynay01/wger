+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:mockito/annotations.dart';
+import 'package:mockito/mockito.dart';
+import 'package:wger/core/network/network_provider.dart';
+import 'package:wger/features/care/models/appointment.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_overview.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+
+import 'care_overview_test.mocks.dart';
+
+const trainer = CareRelationship(
+  id: 'r1',
+  discipline: Discipline.training,
+  status: 'active',
+  professionalName: 'Bruno',
+);
+
+Appointment appointment(String id, String relationship, DateTime start) => Appointment(
+  id: id,
+  relationship: relationship,
+  kind: 'session',
+  start: start,
+  durationMinutes: 50,
+  location: '',
+  status: 'scheduled',
+  discipline: Discipline.training,
+  professional: 'Bruno',
+);
+
+@GenerateMocks([CareRepository])
+void main() {
+  late MockCareRepository repository;
+
+  ProviderContainer container({bool online = true}) {
+    final c = ProviderContainer(
+      overrides: [
+        careRepositoryProvider.overrideWithValue(repository),
+        networkStatusProvider.overrideWithValue(online),
+      ],
+    );
+    addTearDown(c.dispose);
+    return c;
+  }
+
+  setUp(() {
+    repository = MockCareRepository();
+  });
+
+  test('the next appointment is one of the user as patient', () async {
+    when(repository.fetchMyProfessionals()).thenAnswer((_) async => [trainer]);
+    when(repository.fetchUpcomingAppointments(any)).thenAnswer(
+      (_) async => [
+        // The user's own patient, booked earlier
+        appointment('a0', 'other', DateTime.utc(2026, 11, 17)),
+        appointment('a1', 'r1', DateTime.utc(2026, 11, 18)),
+      ],
+    );
+
+    final overview = await container().read(careOverviewProvider.future);
+
+    expect(overview!.professionals, [trainer]);
+    expect(overview.nextAppointment!.id, 'a1');
+  });
+
+  test('nobody follows the user: no appointments asked', () async {
+    when(repository.fetchMyProfessionals()).thenAnswer((_) async => []);
+
+    final overview = await container().read(careOverviewProvider.future);
+
+    expect(overview!.professionals, isEmpty);
+    verifyNever(repository.fetchUpcomingAppointments(any));
+  });
+
+  test('offline: nothing', () async {
+    final overview = await container(online: false).read(careOverviewProvider.future);
+
+    expect(overview, isNull);
+    verifyZeroInteractions(repository);
+  });
+}
