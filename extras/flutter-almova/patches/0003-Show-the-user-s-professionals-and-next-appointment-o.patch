+@riverpod
+CareRepository careRepository(Ref ref) => CareRepository(ref.read(wgerBaseProvider));
+
+/// REST access to the follow-up with professionals (Django app `care`)
+class CareRepository {
+  static const relationshipPath = 'care-relationship';
+  static const appointmentPath = 'appointment';
+
+  final WgerBaseProvider base;
+
+  CareRepository(this.base);
+
+  /// The professionals who follow the user (not the user's own patients)
+  Future<List<CareRelationship>> fetchMyProfessionals() async {
+    final url = base.makeUrl(
+      relationshipPath,
+      query: {'role': 'patient', 'limit': API_MAX_PAGE_SIZE},
+    );
+    final data = await base.fetchPaginated(url);
+    return data
+        .map((e) => CareRelationship.fromJson(e as Map<String, dynamic>))
+        .where((r) => r.isOpen)
+        .toList();
+  }
+
+  /// Scheduled appointments from [from] on, earliest first
+  Future<List<Appointment>> fetchUpcomingAppointments(DateTime from) async {
+    final url = base.makeUrl(
+      appointmentPath,
+      query: {
+        'status': 'scheduled',
+        'start__gte': dateToUtcIso8601(from),
+        'limit': API_MAX_PAGE_SIZE,
+      },
+    );
+    final data = await base.fetchPaginated(url);
+    return data.map((e) => Appointment.fromJson(e as Map<String, dynamic>)).toList()
+      ..sort((a, b) => a.start.compareTo(b.start));
+  }
+}
