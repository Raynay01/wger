+/// An appointment with a professional (Django `care.Appointment`)
+@JsonSerializable()
+class Appointment {
+  @JsonKey(required: true)
+  final String id;
+
+  /// Id of the [CareRelationship]
+  @JsonKey(required: true)
+  final String relationship;
+
+  /// consultation, session, assessment or follow_up
+  @JsonKey(required: true)
+  final String kind;
+
+  @JsonKey(required: true, fromJson: utcIso8601ToLocalDate)
+  final DateTime start;
+
+  @JsonKey(required: true, name: 'duration_minutes')
+  final int durationMinutes;
+
+  @JsonKey(defaultValue: '')
+  final String location;
+
+  @JsonKey(required: true)
+  final String status;
+
+  @JsonKey(unknownEnumValue: JsonKey.nullForUndefinedEnumValue)
+  final Discipline? discipline;
+
+  /// Name of the professional
+  @JsonKey(required: true)
+  final String professional;
+
+  const Appointment({
+    required this.id,
+    required this.relationship,
+    required this.kind,
+    required this.start,
+    required this.durationMinutes,
+    required this.location,
+    required this.status,
+    required this.discipline,
+    required this.professional,
+  });
+
+  factory Appointment.fromJson(Map<String, dynamic> json) => _$AppointmentFromJson(json);
+
+  Map<String, dynamic> toJson() => _$AppointmentToJson(this);
+}
