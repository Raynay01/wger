+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:wger/core/widgets/dashboard/widgets/care.dart';
+import 'package:wger/features/care/models/appointment.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_overview.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+import 'package:wger/l10n/localizations_delegates.dart';
+
+void main() {
+  Widget render(CareOverview? overview, {String locale = 'pt_BR'}) {
+    final parts = locale.split('_');
+    return ProviderScope(
+      overrides: [careOverviewProvider.overrideWith((ref) async => overview)],
+      child: MaterialApp(
+        locale: Locale(parts[0], parts.length > 1 ? parts[1] : null),
+        localizationsDelegates: appLocalizationsDelegates,
+        supportedLocales: AppLocalizations.supportedLocales,
+        home: const Scaffold(body: DashboardCareWidget()),
+      ),
+    );
+  }
+
+  testWidgets('lists the professionals and the next appointment', (tester) async {
+    await tester.pumpWidget(
+      render(
+        CareOverview(
+          professionals: const [
+            CareRelationship(
+              id: 'r1',
+              discipline: Discipline.physio,
+              status: 'active',
+              professionalName: 'Paula',
+            ),
+            CareRelationship(
+              id: 'r2',
+              discipline: Discipline.nutrition,
+              status: 'active',
+              professionalName: 'Nina',
+            ),
+          ],
+          nextAppointment: Appointment(
+            id: 'a1',
+            relationship: 'r1',
+            kind: 'follow_up',
+            start: DateTime(2026, 11, 18, 14, 30),
+            durationMinutes: 50,
+            location: '',
+            status: 'scheduled',
+            discipline: Discipline.physio,
+            professional: 'Paula',
+          ),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+
+    expect(find.text('Acompanhamento'), findsOneWidget);
+    expect(find.text('Paula'), findsOneWidget);
+    expect(find.text('Fisioterapia'), findsOneWidget);
+    expect(find.text('Nutrição'), findsOneWidget);
+    expect(find.text('Próximo atendimento'), findsOneWidget);
+    expect(find.textContaining('Retorno com Paula'), findsOneWidget);
+    expect(find.textContaining('14:30'), findsOneWidget);
+  });
+
+  testWidgets('hidden when nobody follows the user', (tester) async {
+    await tester.pumpWidget(render(const CareOverview(professionals: [])));
+    await tester.pumpAndSettle();
+
+    expect(find.byType(Card), findsNothing);
+  });
+
+  testWidgets('hidden offline', (tester) async {
+    await tester.pumpWidget(render(null));
+    await tester.pumpAndSettle();
+
+    expect(find.byType(Card), findsNothing);
+  });
+}
