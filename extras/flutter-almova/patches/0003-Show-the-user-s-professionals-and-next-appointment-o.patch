+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:intl/intl.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:wger/features/care/models/appointment.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_overview.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+
+String disciplineLabel(AppLocalizations i18n, Discipline? discipline) => switch (discipline) {
+  Discipline.training => i18n.careDisciplineTraining,
+  Discipline.physio => i18n.careDisciplinePhysio,
+  Discipline.nutrition => i18n.careDisciplineNutrition,
+  null => '',
+};
+
+IconData disciplineIcon(Discipline? discipline) => switch (discipline) {
+  Discipline.training => Icons.fitness_center,
+  Discipline.physio => Icons.healing,
+  Discipline.nutrition => Icons.restaurant,
+  null => Icons.person,
+};
+
+String appointmentKindLabel(AppLocalizations i18n, String kind) => switch (kind) {
+  'consultation' => i18n.careAppointmentConsultation,
+  'session' => i18n.careAppointmentSession,
+  'assessment' => i18n.careAppointmentAssessment,
+  'follow_up' => i18n.careAppointmentFollowUp,
+  _ => kind,
+};
+
+/// The professionals who follow the user and the next appointment. Hidden
+/// when nobody follows the user, offline, or on a server without follow-ups.
+class DashboardCareWidget extends ConsumerWidget {
+  const DashboardCareWidget({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final overview = ref.watch(careOverviewProvider).value;
+    if (overview == null || overview.professionals.isEmpty) {
+      return const SizedBox.shrink();
+    }
+    final i18n = AppLocalizations.of(context);
+    final next = overview.nextAppointment;
+
+    return Card(
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          ListTile(
+            title: Text(i18n.careFollowUp, style: Theme.of(context).textTheme.headlineSmall),
+          ),
+          for (final relationship in overview.professionals)
+            ListTile(
+              leading: Icon(disciplineIcon(relationship.discipline)),
+              title: Text(relationship.professionalName),
+              subtitle: Text(disciplineLabel(i18n, relationship.discipline)),
+            ),
+          if (next != null) _NextAppointment(next),
+        ],
+      ),
+    );
+  }
+}
+
+class _NextAppointment extends StatelessWidget {
+  final Appointment appointment;
+
+  const _NextAppointment(this.appointment);
+
+  @override
+  Widget build(BuildContext context) {
+    final i18n = AppLocalizations.of(context);
+    final locale = Localizations.localeOf(context).toString();
+    final when = DateFormat.MMMEd(locale).add_Hm().format(appointment.start);
+
+    return ListTile(
+      leading: const Icon(Icons.event),
+      title: Text(i18n.careNextAppointment),
+      subtitle: Text(
+        '${i18n.careAppointmentWith(appointmentKindLabel(i18n, appointment.kind), appointment.professional)}'
+        '\n$when',
+      ),
+      isThreeLine: true,
+    );
+  }
+}
