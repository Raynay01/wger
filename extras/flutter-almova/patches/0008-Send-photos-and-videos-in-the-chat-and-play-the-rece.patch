+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:wger/features/care/models/message.dart';
+import 'package:wger/features/care/widgets/message_video.dart';
+
+Message video(String name) => Message(
+  id: 'm7',
+  relationship: 'r1',
+  mine: false,
+  text: '',
+  attachmentKind: AttachmentKind.video,
+  attachmentName: name,
+  created: DateTime.utc(2026),
+);
+
+void main() {
+  late Directory dir;
+
+  setUp(() => dir = Directory.systemTemp.createTempSync('almova-video'));
+  tearDown(() => dir.deleteSync(recursive: true));
+
+  test('the downloaded video goes to a file with its own extension', () async {
+    final file = await writeVideoFile(dir, video('Agachamento.MOV'), Uint8List.fromList([1, 2, 3]));
+
+    expect(file.path, endsWith('almova-video-m7.mov'));
+    expect(file.readAsBytesSync(), [1, 2, 3]);
+  });
+
+  test('without a name the file is an mp4', () async {
+    final file = await writeVideoFile(dir, video(''), Uint8List.fromList([1]));
+
+    expect(file.path, endsWith('almova-video-m7.mp4'));
+  });
+}
