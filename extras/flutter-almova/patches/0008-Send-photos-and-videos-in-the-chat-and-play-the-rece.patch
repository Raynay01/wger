+/// Writes a downloaded video to [directory] to play it. The player needs a
+/// file or an address, and the address needs the login, so the bytes go to
+/// a temporary file that the player deletes again.
+Future<File> writeVideoFile(Directory directory, Message message, Uint8List bytes) async {
+  final extension = p.extension(message.attachmentName).toLowerCase();
+  final file = File(
+    p.join(directory.path, 'almova-video-${message.id}${extension.isEmpty ? '.mp4' : extension}'),
+  );
+  await file.writeAsBytes(bytes, flush: true);
+  return file;
+}
+
+/// A video in a message: downloaded on request, then played full screen
+class MessageVideo extends StatelessWidget {
+  final Message message;
+
+  const MessageVideo(this.message, {super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    return OutlinedButton.icon(
+      icon: const Icon(Icons.play_circle),
+      label: Text(AppLocalizations.of(context).careVideo),
+      onPressed: () => Navigator.of(context).push(
+        MaterialPageRoute(builder: (_) => VideoMessageScreen(message: message)),
+      ),
+    );
+  }
+}
+
+class VideoMessageScreen extends ConsumerStatefulWidget {
+  final Message message;
+
+  const VideoMessageScreen({super.key, required this.message});
+
+  @override
+  ConsumerState<VideoMessageScreen> createState() => _VideoMessageScreenState();
+}
+
+class _VideoMessageScreenState extends ConsumerState<VideoMessageScreen> {
+  VideoPlayerController? _controller;
+  File? _file;
+  bool _failed = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _load();
+  }
+
+  Future<void> _load() async {
+    try {
+      final bytes = await ref.read(careRepositoryProvider).fetchAttachment(widget.message.id);
+      final file = await writeVideoFile(await getTemporaryDirectory(), widget.message, bytes);
+      if (!mounted) {
+        await file.delete();
+        return;
+      }
+      _file = file;
+      final controller = VideoPlayerController.file(file);
+      await controller.initialize();
+      if (!mounted) {
+        await controller.dispose();
+        return;
+      }
+      setState(() => _controller = controller..play());
+    } catch (_) {
+      if (mounted) {
+        setState(() => _failed = true);
+      }
+    }
+  }
+
+  @override
+  void dispose() {
+    _controller?.dispose();
+    // Health videos do not stay on the phone
+    _file?.delete().ignore();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final controller = _controller;
+    return Scaffold(
+      appBar: AppBar(title: Text(AppLocalizations.of(context).careVideo)),
+      body: Center(
+        child: _failed
+            ? const Icon(Icons.broken_image)
+            : controller == null
+            ? const CenteredProgressIndicator()
+            : GestureDetector(
+                onTap: () => setState(
+                  () => controller.value.isPlaying ? controller.pause() : controller.play(),
+                ),
+                child: AspectRatio(
+                  aspectRatio: controller.value.aspectRatio,
+                  child: VideoPlayer(controller),
+                ),
+              ),
+      ),
+    );
+  }
+}
