+  /// Sends a photo or video, with an optional text. The server checks the
+  /// file (format, size, virus scan) and removes the photo's location.
+  Future<Message> sendAttachment(String relationshipId, XFile file, {String text = ''}) async {
+    final request = http.MultipartRequest('POST', base.makeUrl(messagePath))
+      ..headers.addAll({HttpHeaders.userAgentHeader: base.getAppNameHeaderValue()})
+      ..fields['relationship'] = relationshipId
+      ..fields['text'] = text
+      ..files.add(await http.MultipartFile.fromPath('attachment', file.path, filename: file.name));
+    final response = await http.Response.fromStream(await base.client.send(request));
+    if (response.statusCode >= 400) {
+      throw WgerHttpException(response);
+    }
+    return Message.fromJson(json.decode(response.body) as Map<String, dynamic>);
   }
 
