+@GenerateMocks([GalleryRepository])
+void main() {
+  late MockGalleryRepository repository;
+
+  setUp(() {
+    repository = MockGalleryRepository();
+  });
+
+  Widget render(Widget child) => ProviderScope(
+    overrides: [galleryRepositoryProvider.overrideWithValue(repository)],
+    child: MaterialApp(home: Scaffold(body: child)),
+  );
+
+  testWidgets('shows the file downloaded with the login', (tester) async {
+    final image = getTestImages().first;
+    when(repository.fetchImageFile(image.id)).thenAnswer((_) async => png);
+
+    await tester.pumpWidget(render(GalleryPhoto(image: image)));
+    await tester.pumpAndSettle();
+
+    final shown = tester.widget<Image>(find.byType(Image));
+    expect((shown.image as MemoryImage).bytes, png);
+    expect(find.byType(ImageError), findsNothing);
+  });
+
+  testWidgets('a photo on screen twice is downloaded once', (tester) async {
+    final image = getTestImages().first;
+    when(repository.fetchImageFile(image.id)).thenAnswer((_) async => png);
+
+    await tester.pumpWidget(
+      render(
+        Column(
+          children: [
+            Expanded(child: GalleryPhoto(image: image)),
+            Expanded(child: GalleryPhoto(image: image)),
+          ],
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+
+    verify(repository.fetchImageFile(image.id)).called(1);
+  });
+
+  testWidgets('shows an error when the download fails', (tester) async {
+    final image = getTestImages().first;
+    when(repository.fetchImageFile(image.id)).thenAnswer((_) async => throw Exception('404'));
+
+    await tester.pumpWidget(render(GalleryPhoto(image: image)));
+    await tester.pump();
+    await tester.pump();
+
+    expect(find.byType(ImageError), findsOneWidget);
+  });
+}
