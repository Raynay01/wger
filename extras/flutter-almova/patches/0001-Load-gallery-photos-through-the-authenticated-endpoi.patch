+import 'dart:async';
+import 'dart:typed_data';
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:wger/features/gallery/providers/gallery_repository.dart';
+
+/// How long a downloaded photo stays in memory after the last widget showing
+/// it went away, so scrolling back and forth does not download it again.
+const galleryImageFileCacheTime = Duration(minutes: 5);
+
+/// The file of a gallery image. Keyed by the storage path as well, so a
+/// replaced file is downloaded again.
+final galleryImageFileProvider = FutureProvider.autoDispose
+    .family<Uint8List, ({int id, String? path})>((ref, image) {
+      final link = ref.keepAlive();
+      Timer? timer;
+      ref.onCancel(() => timer = Timer(galleryImageFileCacheTime, link.close));
+      ref.onResume(() => timer?.cancel());
+      ref.onDispose(() => timer?.cancel());
+      return ref.read(galleryRepositoryProvider).fetchImageFile(image.id);
+    });
