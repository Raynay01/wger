+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:wger/core/widgets/image.dart';
+import 'package:wger/core/widgets/progress_indicator.dart';
+import 'package:wger/features/gallery/models/image.dart';
+import 'package:wger/features/gallery/providers/gallery_image_file.dart';
+
+/// A gallery photo, downloaded with the user's login (the files are private).
+class GalleryPhoto extends ConsumerWidget {
+  final GalleryImage image;
+  final BoxFit fit;
+
+  const GalleryPhoto({super.key, required this.image, this.fit = BoxFit.cover});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final id = image.id;
+    if (id == null) {
+      return const ImageError('');
+    }
+
+    final file = ref.watch(galleryImageFileProvider((id: id, path: image.imagePath)));
+    // The error shows while Riverpod retries in the background
+    return switch (file) {
+      AsyncValue(:final value?) => Image.memory(value, fit: fit),
+      AsyncValue(:final error?) => ImageError('Network error', errorMessage: error.toString()),
+      _ => const CenteredProgressIndicator(),
+    };
+  }
+}
