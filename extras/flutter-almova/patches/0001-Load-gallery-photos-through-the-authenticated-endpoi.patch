+import 'dart:typed_data';
+
+import 'package:fake_async/fake_async.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:mockito/annotations.dart';
+import 'package:mockito/mockito.dart';
+import 'package:wger/features/gallery/providers/gallery_image_file.dart';
+import 'package:wger/features/gallery/providers/gallery_repository.dart';
+
+import 'gallery_image_file_test.mocks.dart';
+
+@GenerateMocks([GalleryRepository])
+void main() {
+  test('keeps a photo for a while after the last viewer, then downloads it again', () {
+    fakeAsync((async) {
+      final repository = MockGalleryRepository();
+      when(repository.fetchImageFile(3)).thenAnswer((_) async => Uint8List.fromList([1]));
+      final container = ProviderContainer(
+        overrides: [galleryRepositoryProvider.overrideWithValue(repository)],
+      );
+      addTearDown(container.dispose);
+      final photo = galleryImageFileProvider((id: 3, path: 'gallery/1/a.jpg'));
+
+      void view() {
+        container.listen(photo, (_, _) {}).close();
+        async.flushMicrotasks();
+      }
+
+      view();
+      async.elapse(galleryImageFileCacheTime - const Duration(seconds: 1));
+      view();
+      verify(repository.fetchImageFile(3)).called(1);
+
+      async.elapse(galleryImageFileCacheTime + const Duration(seconds: 1));
+      view();
+      verify(repository.fetchImageFile(3)).called(1);
+    });
+  });
+
+  test('a replaced file is downloaded again', () {
+    fakeAsync((async) {
+      final repository = MockGalleryRepository();
+      when(repository.fetchImageFile(3)).thenAnswer((_) async => Uint8List.fromList([1]));
+      final container = ProviderContainer(
+        overrides: [galleryRepositoryProvider.overrideWithValue(repository)],
+      );
+      addTearDown(container.dispose);
+
+      container.listen(galleryImageFileProvider((id: 3, path: 'gallery/1/a.jpg')), (_, _) {});
+      container.listen(galleryImageFileProvider((id: 3, path: 'gallery/1/b.jpg')), (_, _) {});
+      async.flushMicrotasks();
+
+      verify(repository.fetchImageFile(3)).called(2);
+    });
+  });
+}
