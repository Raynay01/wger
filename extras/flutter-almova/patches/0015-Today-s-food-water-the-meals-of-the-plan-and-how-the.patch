+import 'package:riverpod_annotation/riverpod_annotation.dart';
+import 'package:wger/features/nutrition/models/nutrition_day.dart';
+import 'package:wger/features/nutrition/providers/nutrition_day_repository.dart';
+
+part 'nutrition_today_notifier.g.dart';
+
+@riverpod
+class NutritionTodayNotifier extends _$NutritionTodayNotifier {
+  @override
+  Future<NutritionDay> build() => ref.read(nutritionDayRepositoryProvider).fetchToday();
+
+  Future<void> addWater(int amountMl) async {
+    await ref.read(nutritionDayRepositoryProvider).addWater(amountMl);
+    final day = state.value;
+    if (day != null) {
+      state = AsyncData(day.copyWith(waterMl: day.waterMl + amountMl));
+    }
+  }
+
+  Future<void> setAdherence(PlannedMeal meal, String status) async {
+    final day = state.requireValue;
+    final repository = ref.read(nutritionDayRepositoryProvider);
+    if (status == 'full' && day.planId != null) {
+      await repository.followMeal(day.planId!, meal, day.date);
+      // The diary changed: reload the totals of the day
+      ref.invalidateSelf();
+      await future;
+      return;
+    }
+    await repository.setAdherence(meal.id, day.date, status);
+    state = AsyncData(
+      day.copyWith(
+        meals: [
+          for (final m in day.meals)
+            if (m.id == meal.id) m.withAdherence(status) else m,
+        ],
+      ),
+    );
+  }
+}
