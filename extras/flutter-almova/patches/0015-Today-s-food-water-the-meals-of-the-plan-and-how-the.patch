+import 'package:wger/l10n/generated/app_localizations.dart';
+
+/// Water amounts offered as buttons, as in the web app
+const waterAmountsMl = [200, 300, 500];
+
+String adherenceLabel(AppLocalizations i18n, String status) => switch (status) {
+  'full' => i18n.nutritionFollowed,
+  'partial' => i18n.nutritionPartlyFollowed,
+  _ => i18n.nutritionNotFollowed,
+};
+
+/// Today's food: totals against the goals, water and the meals of the plan
+class NutritionTodayScreen extends ConsumerWidget {
+  const NutritionTodayScreen({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    final today = ref.watch(nutritionTodayProvider);
+
+    return Scaffold(
+      appBar: AppBar(title: Text(i18n.nutritionToday)),
+      body: switch (today) {
+        AsyncValue(:final value?) => ListView(
+          padding: const EdgeInsets.all(8),
+          children: [
+            _Totals(value),
+            _Water(value),
+            if (value.planId == null)
+              Card(
+                child: ListTile(
+                  title: Text(i18n.nutritionNoPlan),
+                  subtitle: Text(i18n.nutritionNoPlanHint),
+                ),
+              )
+            else
+              for (final meal in value.meals) MealCard(meal),
+          ],
+        ),
+        AsyncValue(:final error?) => Center(child: Text(error.toString())),
+        _ => const CenteredProgressIndicator(),
+      },
+    );
+  }
+}
+
+String _number(BuildContext context, double value) =>
+    NumberFormat.decimalPattern(Localizations.localeOf(context).toString()).format(value.round());
+
+class _Meter extends StatelessWidget {
+  final String label;
+  final double value;
+  final double? goal;
+  final String unit;
+
+  const _Meter(this.label, this.value, this.goal, this.unit);
+
+  @override
+  Widget build(BuildContext context) {
+    final goal = this.goal;
+    return Padding(
+      padding: const EdgeInsets.symmetric(vertical: 4),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(
+            goal == null
+                ? '$label: ${_number(context, value)} $unit'
+                : '$label: ${_number(context, value)} / ${_number(context, goal)} $unit',
+          ),
+          if (goal != null && goal > 0)
+            LinearProgressIndicator(value: (value / goal).clamp(0, 1).toDouble()),
+        ],
+      ),
+    );
+  }
+}
+
+class _Totals extends StatelessWidget {
+  final NutritionDay day;
+
+  const _Totals(this.day);
+
+  @override
+  Widget build(BuildContext context) {
+    final i18n = AppLocalizations.of(context);
+    final remaining = day.goals.energy == null
+        ? null
+        : (day.goals.energy! - (day.logged.energy ?? 0)).clamp(0, double.infinity).toDouble();
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(i18n.nutritionToday, style: Theme.of(context).textTheme.titleLarge),
+            if (day.planDescription.isNotEmpty) Text(day.planDescription),
+            _Meter(i18n.nutritionCalories, day.logged.energy ?? 0, day.goals.energy, 'kcal'),
+            _Meter(i18n.nutritionProtein, day.logged.protein ?? 0, day.goals.protein, 'g'),
+            _Meter(
+              i18n.nutritionCarbohydrates,
+              day.logged.carbohydrates ?? 0,
+              day.goals.carbohydrates,
+              'g',
+            ),
+            _Meter(i18n.nutritionFat, day.logged.fat ?? 0, day.goals.fat, 'g'),
+            if (remaining != null)
+              Padding(
+                padding: const EdgeInsets.only(top: 8),
+                child: Text(i18n.nutritionRemaining(_number(context, remaining))),
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class _Water extends ConsumerWidget {
+  final NutritionDay day;
+
+  const _Water(this.day);
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(i18n.nutritionWater, style: Theme.of(context).textTheme.titleLarge),
+            _Meter(
+              i18n.nutritionWaterToday,
+              day.waterMl.toDouble(),
+              day.waterGoalMl?.toDouble(),
+              'ml',
+            ),
+            if (day.waterGoalMl == null) Text(i18n.nutritionNoWaterGoal),
+            Wrap(
+              spacing: 8,
+              children: [
+                for (final amount in waterAmountsMl)
+                  OutlinedButton(
+                    onPressed: () => _add(context, ref, amount),
+                    child: Text('+ $amount ml'),
+                  ),
+              ],
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Future<void> _add(BuildContext context, WidgetRef ref, int amount) async {
+    final failed = AppLocalizations.of(context).careSendFailed;
+    try {
+      await ref.read(nutritionTodayProvider.notifier).addWater(amount);
+    } catch (_) {
+      if (context.mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(failed)));
+      }
+    }
+  }
+}
+
+class MealCard extends ConsumerWidget {
+  final PlannedMeal meal;
+
+  const MealCard(this.meal, {super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    final adherence = meal.adherence;
+    final title = [
+      ?meal.time,
+      if (meal.name.isNotEmpty) meal.name else i18n.nutritionMeal,
+    ].join(' · ');
+
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text(title, style: Theme.of(context).textTheme.titleMedium),
+            if (meal.planned.energy != null) Text('${_number(context, meal.planned.energy!)} kcal'),
+            for (final item in meal.items)
+              Text(
+                item.unitName == null
+                    ? '${_number(context, item.amount)} g · ${item.name}'
+                    : '${item.amount} × ${item.unitName} (${_number(context, item.grams)} g) · ${item.name}',
+              ),
+            if (meal.instructions.isNotEmpty)
+              Text(meal.instructions, style: Theme.of(context).textTheme.bodySmall),
+            const SizedBox(height: 8),
+            if (adherence != null)
+              Chip(label: Text(adherenceLabel(i18n, adherence)))
+            else
+              Wrap(
+                spacing: 8,
+                children: [
+                  FilledButton(
+                    onPressed: () => _answer(context, ref, 'full'),
+                    child: Text(i18n.nutritionFollowed),
+                  ),
+                  for (final status in ['partial', 'skipped'])
+                    OutlinedButton(
+                      onPressed: () => _answer(context, ref, status),
+                      child: Text(adherenceLabel(i18n, status)),
+                    ),
+                ],
+              ),
+          ],
+        ),
+      ),
+    );
+  }
+
+  Future<void> _answer(BuildContext context, WidgetRef ref, String status) async {
+    final failed = AppLocalizations.of(context).careSendFailed;
+    try {
+      await ref.read(nutritionTodayProvider.notifier).setAdherence(meal, status);
+    } catch (_) {
+      if (context.mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(failed)));
+      }
+    }
+  }
+}
