+
+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:wger/core/network/base_provider.dart';
+import 'package:wger/features/nutrition/models/nutrition_day.dart';
+import 'package:wger/features/nutrition/providers/nutrition_day_repository.dart';
+
+/// As the server answers care/my-day (shape taken from a real answer)
+final myDay = {
+  'date': '2026-11-17',
+  'nutrition': {
+    'plan': {'id': 'p1', 'description': 'Plano de emagrecimento', 'author': 214},
+    'goals': {'energy': 1800, 'protein': 110, 'carbohydrates': 200, 'fat': 60, 'fiber': null},
+    'logged': null,
+    'remaining': {'energy': 1800},
+    'water': {'total_ml': 400, 'goal_ml': 2500},
+    'meals': [
+      {
+        'id': 'm1',
+        'name': 'Café da manhã',
+        'time': '07:30:00',
+        'instructions': '',
+        'planned': {'energy': 354.0, 'protein': 46.134, 'carbohydrates': 0.225, 'fat': 14.985},
+        'items': [
+          {
+            'ingredient': 1,
+            'name': 'Ovo',
+            'amount': 150.0,
+            'weight_unit': null,
+            'unit_name': null,
+            'grams': 150.0,
+            'instructions': '',
+            'substitutions': 0,
+          },
+          {
+            'ingredient': 2,
+            'name': 'Pão',
+            'amount': '2.00',
+            'weight_unit': 7,
+            'unit_name': 'fatia',
+            'grams': 50.0,
+            'instructions': 'Integral',
+            'substitutions': 1,
+          },
+        ],
+        'adherence': null,
+      },
+    ],
+  },
+};
+
+void main() {
+  late List<http.Request> sent;
+
+  NutritionDayRepository answering(Object body) {
+    sent = [];
+    return NutritionDayRepository(
+      WgerBaseProvider(
+        serverUrl: 'https://almova.test',
+        client: MockClient((request) async {
+          sent.add(request);
+          return http.Response.bytes(
+            utf8.encode(json.encode(body)),
+            200,
+            headers: {'content-type': 'application/json'},
+          );
+        }),
+      ),
+    );
+  }
+
+  test('the food of the day from the day of the user', () async {
+    final day = await answering(myDay).fetchToday();
+
+    expect(sent.single.url.path, '/api/v2/care/my-day/');
+    expect(day.date, '2026-11-17');
+    expect(day.planId, 'p1');
+    expect(day.goals.energy, 1800);
+    expect(day.logged.energy, isNull);
+    expect((day.waterMl, day.waterGoalMl), (400, 2500));
+    final meal = day.meals.single;
+    expect((meal.id, meal.time), ('m1', '07:30'));
+    expect(meal.items[1].amount, 2);
+    expect(meal.items[1].unitName, 'fatia');
+    expect(meal.adherence, isNull);
+  });
+
+  test('without a plan only the water', () async {
+    final day = NutritionDay.fromDayJson({
+      'date': '2026-11-17',
+      'nutrition': {
+        'plan': null,
+        'goals': null,
+        'logged': null,
+        'meals': [],
+        'water': {'total_ml': 0, 'goal_ml': null},
+      },
+    });
+
+    expect(day.planId, isNull);
+    expect(day.waterGoalMl, isNull);
+    expect(day.meals, isEmpty);
+  });
+
+  test('water, the answer per meal and "followed" with the diary', () async {
+    final repository = answering({});
+    final meal = NutritionDay.fromDayJson(myDay).meals.single;
+
+    await repository.addWater(300);
+    await repository.setAdherence('m1', '2026-11-17', 'partial');
+    sent.clear();
+    await repository.followMeal('p1', meal, '2026-11-17');
+
+    expect(sent.map((r) => r.url.path), [
+      '/api/v2/nutritiondiary/',
+      '/api/v2/nutritiondiary/',
+      '/api/v2/meal-adherence/',
+    ]);
+    expect(json.decode(sent[1].body), {
+      'plan': 'p1',
+      'meal': 'm1',
+      'ingredient': 2,
+      'amount': 2.0,
+      'weight_unit': 7,
+    });
+    expect(json.decode(sent[2].body), {'meal': 'm1', 'date': '2026-11-17', 'status': 'full'});
+  });
+}
