+/// The server sends decimals as numbers or strings
+double? _number(Object? value) => switch (value) {
+  final num v => v.toDouble(),
+  final String v => double.tryParse(v),
+  _ => null,
+};
+
+/// Energy (kcal) and macronutrients (g) of the day
+class DayValues {
+  final double? energy;
+  final double? protein;
+  final double? carbohydrates;
+  final double? fat;
+
+  const DayValues({this.energy, this.protein, this.carbohydrates, this.fat});
+
+  factory DayValues.fromJson(Map<String, dynamic>? json) => DayValues(
+    energy: _number(json?['energy']),
+    protein: _number(json?['protein']),
+    carbohydrates: _number(json?['carbohydrates']),
+    fat: _number(json?['fat']),
+  );
+}
+
+class PlannedItem {
+  final int ingredient;
+  final String name;
+  final double amount;
+  final int? weightUnit;
+  final String? unitName;
+  final double grams;
+  final String instructions;
+
+  const PlannedItem({
+    required this.ingredient,
+    required this.name,
+    required this.amount,
+    this.weightUnit,
+    this.unitName,
+    required this.grams,
+    this.instructions = '',
+  });
+
+  factory PlannedItem.fromJson(Map<String, dynamic> json) => PlannedItem(
+    ingredient: json['ingredient'] as int,
+    name: json['name'] as String? ?? '',
+    amount: _number(json['amount']) ?? 0,
+    weightUnit: json['weight_unit'] as int?,
+    unitName: json['unit_name'] as String?,
+    grams: _number(json['grams']) ?? 0,
+    instructions: json['instructions'] as String? ?? '',
+  );
+}
+
+class PlannedMeal {
+  final String id;
+  final String name;
+
+  /// "HH:MM" or null
+  final String? time;
+  final String instructions;
+  final DayValues planned;
+  final List<PlannedItem> items;
+
+  /// full, partial, skipped or null when not answered yet
+  final String? adherence;
+
+  const PlannedMeal({
+    required this.id,
+    required this.name,
+    this.time,
+    this.instructions = '',
+    this.planned = const DayValues(),
+    this.items = const [],
+    this.adherence,
+  });
+
+  PlannedMeal withAdherence(String status) => PlannedMeal(
+    id: id,
+    name: name,
+    time: time,
+    instructions: instructions,
+    planned: planned,
+    items: items,
+    adherence: status,
+  );
+
+  factory PlannedMeal.fromJson(Map<String, dynamic> json) {
+    final time = json['time'] as String?;
+    return PlannedMeal(
+      id: json['id'] as String,
+      name: json['name'] as String? ?? '',
+      time: time == null || time.length < 5 ? time : time.substring(0, 5),
+      instructions: json['instructions'] as String? ?? '',
+      planned: DayValues.fromJson(json['planned'] as Map<String, dynamic>?),
+      items: [
+        for (final item in json['items'] as List? ?? const [])
+          PlannedItem.fromJson(item as Map<String, dynamic>),
+      ],
+      adherence: json['adherence'] as String?,
+    );
+  }
+}
+
+/// The food of the user's day (care/my-day, section nutrition)
+class NutritionDay {
+  /// Calendar day in the user's time zone, YYYY-MM-DD
+  final String date;
+  final String? planId;
+  final String planDescription;
+  final DayValues goals;
+  final DayValues logged;
+  final int waterMl;
+  final int? waterGoalMl;
+  final List<PlannedMeal> meals;
+
+  const NutritionDay({
+    required this.date,
+    this.planId,
+    this.planDescription = '',
+    this.goals = const DayValues(),
+    this.logged = const DayValues(),
+    this.waterMl = 0,
+    this.waterGoalMl,
+    this.meals = const [],
+  });
+
+  NutritionDay copyWith({int? waterMl, List<PlannedMeal>? meals}) => NutritionDay(
+    date: date,
+    planId: planId,
+    planDescription: planDescription,
+    goals: goals,
+    logged: logged,
+    waterMl: waterMl ?? this.waterMl,
+    waterGoalMl: waterGoalMl,
+    meals: meals ?? this.meals,
+  );
+
+  /// From the whole day of care/my-day
+  factory NutritionDay.fromDayJson(Map<String, dynamic> day) {
+    final nutrition = day['nutrition'] as Map<String, dynamic>? ?? const {};
+    final plan = nutrition['plan'] as Map<String, dynamic>?;
+    final water = nutrition['water'] as Map<String, dynamic>? ?? const {};
+    return NutritionDay(
+      date: day['date'] as String,
+      planId: plan?['id'] as String?,
+      planDescription: plan?['description'] as String? ?? '',
+      goals: DayValues.fromJson(nutrition['goals'] as Map<String, dynamic>?),
+      logged: DayValues.fromJson(nutrition['logged'] as Map<String, dynamic>?),
+      waterMl: (_number(water['total_ml']) ?? 0).round(),
+      waterGoalMl: _number(water['goal_ml'])?.round(),
+      meals: [
+        for (final meal in nutrition['meals'] as List? ?? const [])
+          PlannedMeal.fromJson(meal as Map<String, dynamic>),
+      ],
+    );
+  }
+}
