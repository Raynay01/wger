+import 'dart:convert';
+
+import 'package:riverpod_annotation/riverpod_annotation.dart';
+import 'package:wger/core/exceptions/http_exception.dart';
+import 'package:wger/core/network/base_provider.dart';
+import 'package:wger/core/network/wger_base.dart';
+import 'package:wger/features/nutrition/models/nutrition_day.dart';
+
+part 'nutrition_day_repository.g.dart';
+
+@riverpod
+NutritionDayRepository nutritionDayRepository(Ref ref) =>
+    NutritionDayRepository(ref.read(wgerBaseProvider));
+
+/// REST access to the food of the day: water and how the meals were followed
+class NutritionDayRepository {
+  final WgerBaseProvider base;
+
+  NutritionDayRepository(this.base);
+
+  Future<NutritionDay> fetchToday() async {
+    final data = await base.fetch(base.makeUrl('care/my-day'));
+    return NutritionDay.fromDayJson(data as Map<String, dynamic>);
+  }
+
+  Future<void> addWater(int amountMl) => _post('water-log', {'amount_ml': amountMl});
+
+  /// One record per meal and day: posting again changes it
+  Future<void> setAdherence(String mealId, String date, String status) =>
+      _post('meal-adherence', {'meal': mealId, 'date': date, 'status': status});
+
+  /// "Followed": the prescribed items go to the food diary and the meal is
+  /// marked as followed, as in the web app
+  Future<void> followMeal(String planId, PlannedMeal meal, String date) async {
+    for (final item in meal.items) {
+      await _post('nutritiondiary', {
+        'plan': planId,
+        'meal': meal.id,
+        'ingredient': item.ingredient,
+        'amount': item.amount,
+        'weight_unit': item.weightUnit,
+      });
+    }
+    await setAdherence(meal.id, date, 'full');
+  }
+
+  Future<void> _post(String path, Map<String, dynamic> body) async {
+    final response = await base.client.post(
+      base.makeUrl(path),
+      headers: base.getDefaultHeaders(),
+      body: json.encode(body),
+    );
+    if (response.statusCode >= 400) {
+      throw WgerHttpException(response);
+    }
+  }
+}
