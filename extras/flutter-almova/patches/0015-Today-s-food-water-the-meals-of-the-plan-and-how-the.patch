+import 'package:wger/l10n/generated/app_localizations.dart';
+import 'package:wger/l10n/localizations_delegates.dart';
+
+import '../providers/nutrition_day_repository_test.dart' show myDay;
+import 'nutrition_today_screen_test.mocks.dart';
+
+@GenerateMocks([NutritionDayRepository])
+void main() {
+  late MockNutritionDayRepository repository;
+  late NutritionDay day;
+
+  setUp(() {
+    repository = MockNutritionDayRepository();
+    day = NutritionDay.fromDayJson(myDay);
+    when(repository.fetchToday()).thenAnswer((_) async => day);
+  });
+
+  Future<void> render(WidgetTester tester) async {
+    tester.view.physicalSize = const Size(1080, 3000);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [nutritionDayRepositoryProvider.overrideWithValue(repository)],
+        child: const MaterialApp(
+          locale: Locale('pt', 'BR'),
+          localizationsDelegates: appLocalizationsDelegates,
+          supportedLocales: AppLocalizations.supportedLocales,
+          home: NutritionTodayScreen(),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+  }
+
+  testWidgets('shows goals, water and the meal of the plan', (tester) async {
+    await render(tester);
+
+    expect(find.text('Calorias: 0 / 1.800 kcal'), findsOneWidget);
+    expect(find.text('Restam 1.800 kcal para a meta do dia.'), findsOneWidget);
+    expect(find.text('Hoje: 400 / 2.500 ml'), findsOneWidget);
+    expect(find.text('07:30 · Café da manhã'), findsOneWidget);
+    expect(find.text('150 g · Ovo'), findsOneWidget);
+    expect(find.text('2.0 × fatia (50 g) · Pão'), findsOneWidget);
+  });
+
+  testWidgets('water adds up', (tester) async {
+    when(repository.addWater(300)).thenAnswer((_) async {});
+    await render(tester);
+
+    await tester.tap(find.text('+ 300 ml'));
+    await tester.pumpAndSettle();
+
+    verify(repository.addWater(300)).called(1);
+    expect(find.text('Hoje: 700 / 2.500 ml'), findsOneWidget);
+  });
+
+  testWidgets('"Partly followed" is recorded for the day', (tester) async {
+    when(repository.setAdherence('m1', '2026-11-17', 'partial')).thenAnswer((_) async {});
+    await render(tester);
+
+    await tester.tap(find.text('Segui parcialmente'));
+    await tester.pumpAndSettle();
+
+    verify(repository.setAdherence('m1', '2026-11-17', 'partial')).called(1);
+    expect(find.widgetWithText(Chip, 'Segui parcialmente'), findsOneWidget);
+    expect(find.text('Não segui'), findsNothing);
+  });
+
+  testWidgets('"Followed" goes to the diary and reloads the totals', (tester) async {
+    when(repository.followMeal('p1', any, '2026-11-17')).thenAnswer((_) async {
+      day = NutritionDay.fromDayJson({
+        ...myDay,
+        'nutrition': {
+          ...(myDay['nutrition']! as Map<String, dynamic>),
+          'logged': {'energy': 354.0, 'protein': 46.1, 'carbohydrates': 0.2, 'fat': 15.0},
+          'meals': [
+            {
+              ...((myDay['nutrition']! as Map<String, dynamic>)['meals'] as List).first
+                  as Map<String, dynamic>,
+              'adherence': 'full',
+            },
+          ],
+        },
+      });
+    });
+    await render(tester);
+
+    await tester.tap(find.widgetWithText(FilledButton, 'Segui'));
+    await tester.pumpAndSettle();
+
+    verify(repository.followMeal('p1', any, '2026-11-17')).called(1);
+    expect(find.text('Calorias: 354 / 1.800 kcal'), findsOneWidget);
+    expect(find.widgetWithText(Chip, 'Segui'), findsOneWidget);
+  });
+}
