+
+String painMomentLabel(AppLocalizations i18n, String moment) => switch (moment) {
+  'before' => i18n.physioPainBefore,
+  'during' => i18n.physioPainDuring,
+  'after' => i18n.physioPainAfter,
+  'next_day' => i18n.physioPainNextDay,
+  _ => i18n.physioPainOther,
+};
+
+String exerciseLocationLabel(AppLocalizations i18n, String location) => switch (location) {
+  'home' => i18n.physioAtHome,
+  'gym' => i18n.physioAtGym,
+  'clinic' => i18n.physioAtClinic,
+  _ => '',
+};
+
+/// Today's physiotherapy: the exercises of the protocols and the pain
+class PhysioTodayScreen extends ConsumerWidget {
+  const PhysioTodayScreen({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    final today = ref.watch(physioTodayProvider);
+
+    return Scaffold(
+      appBar: AppBar(title: Text(i18n.physioToday)),
+      body: switch (today) {
+        AsyncValue(:final value?) => ListView(
+          padding: const EdgeInsets.all(8),
+          children: [
+            if (value.protocols.isEmpty)
+              Padding(padding: const EdgeInsets.all(16), child: Text(i18n.physioNoProtocol)),
+            for (final protocol in value.protocols)
+              Card(
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    ListTile(
+                      title: Text(protocol.name, style: Theme.of(context).textTheme.titleLarge),
+                    ),
+                    for (final exercise in protocol.exercises) PhysioExerciseTile(exercise),
+                  ],
+                ),
+              ),
+            Card(
+              child: Padding(
+                padding: const EdgeInsets.all(16),
+                child: PainForm(day: value),
+              ),
+            ),
+          ],
+        ),
+        AsyncValue(:final error?) => Center(child: Text(error.toString())),
+        _ => const CenteredProgressIndicator(),
+      },
+    );
+  }
+}
+
+class PhysioExerciseTile extends ConsumerWidget {
+  final PhysioExercise exercise;
+
+  const PhysioExerciseTile(this.exercise, {super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    final dose = [
+      if (exercise.sets != null) i18n.physioSets(exercise.sets!),
+      if (exercise.repetitions != null) i18n.physioRepetitions(exercise.repetitions!),
+      if (exercise.durationSeconds != null) '${exercise.durationSeconds} s',
+      if (exercise.load.isNotEmpty) exercise.load,
+    ].join(' · ');
+    final where = exerciseLocationLabel(i18n, exercise.location);
+
+    return Padding(
+      padding: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(exercise.name, style: Theme.of(context).textTheme.titleMedium),
+          if (dose.isNotEmpty) Text(dose),
+          if (where.isNotEmpty) Text(where, style: Theme.of(context).textTheme.bodySmall),
+          if (exercise.instructions.isNotEmpty) Text(exercise.instructions),
+          Wrap(
+            spacing: 8,
+            crossAxisAlignment: WrapCrossAlignment.center,
+            children: [
+              if (exercise.videoUrl.isNotEmpty)
+                TextButton.icon(
+                  icon: const Icon(Icons.play_circle),
+                  label: Text(i18n.physioWatchVideo),
+                  onPressed: () => launchURL(exercise.videoUrl, context),
+                ),
+              if (exercise.done)
+                Chip(avatar: const Icon(Icons.check), label: Text(i18n.physioDoneToday))
+              else
+                OutlinedButton(
+                  onPressed: () => _markDone(context, ref),
+                  child: Text(i18n.physioMarkDone),
+                ),
+            ],
+          ),
+        ],
+      ),
+    );
+  }
+
+  Future<void> _markDone(BuildContext context, WidgetRef ref) async {
+    try {
+      await ref.read(physioTodayProvider.notifier).markDone(exercise.id);
+    } catch (_) {
+      if (context.mounted) {
+        ScaffoldMessenger.of(context).showSnackBar(
+          SnackBar(content: Text(AppLocalizations.of(context).careSendFailed)),
+        );
+      }
+    }
+  }
+}
+
+/// Pain on the 0 to 10 scale, at a moment the physiotherapist asks for
+class PainForm extends ConsumerStatefulWidget {
+  final PhysioDay day;
+
+  const PainForm({super.key, required this.day});
+
+  @override
+  ConsumerState<PainForm> createState() => _PainFormState();
+}
+
+class _PainFormState extends ConsumerState<PainForm> {
+  final _form = GlobalKey<FormState>();
+  String? _protocolId;
+  late String _moment;
+  int? _value;
+  String _region = '';
+  String _notes = '';
+  bool _saving = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _protocolId = widget.day.protocols.firstOrNull?.id;
+    _moment = _moments.first;
+  }
+
+  List<String> get _moments {
+    final protocol = widget.day.protocols.where((p) => p.id == _protocolId).firstOrNull;
+    return {...?protocol?.painMoments, 'other'}.toList();
+  }
+
+  void _say(String text) {
+    ScaffoldMessenger.of(context)
+      ..hideCurrentSnackBar()
+      ..showSnackBar(SnackBar(content: Text(text)));
+  }
+
+  Future<void> _save() async {
+    final i18n = AppLocalizations.of(context);
+    if (_value == null) {
+      _say(i18n.physioPainChooseValue);
+      return;
+    }
+    _form.currentState!.save();
+    setState(() => _saving = true);
+    try {
+      await ref
+          .read(physioTodayProvider.notifier)
+          .recordPain(
+            protocolId: _protocolId,
+            moment: _moment,
+            value: _value!,
+            bodyRegion: _region.trim(),
+            notes: _notes.trim(),
+          );
+      if (mounted) {
+        _form.currentState!.reset();
+        setState(() => _value = null);
+        _say(i18n.physioPainSaved);
+      }
+    } catch (_) {
+      if (mounted) {
+        _say(i18n.careSendFailed);
+      }
+    } finally {
+      if (mounted) {
+        setState(() => _saving = false);
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final i18n = AppLocalizations.of(context);
+    final protocols = widget.day.protocols;
+
+    return Form(
+      key: _form,
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(i18n.physioPainQuestion, style: Theme.of(context).textTheme.titleLarge),
+          if (protocols.length > 1)
+            DropdownButtonFormField<String>(
+              initialValue: _protocolId,
+              decoration: InputDecoration(labelText: i18n.physioProtocol),
+              items: [
+                for (final p in protocols) DropdownMenuItem(value: p.id, child: Text(p.name)),
+              ],
+              onChanged: (id) => setState(() {
+                _protocolId = id;
+                _moment = _moments.first;
+              }),
+            ),
+          DropdownButtonFormField<String>(
+            key: ValueKey(_protocolId),
+            initialValue: _moment,
+            decoration: InputDecoration(labelText: i18n.physioPainMoment),
+            items: [
+              for (final m in _moments)
+                DropdownMenuItem(value: m, child: Text(painMomentLabel(i18n, m))),
+            ],
+            onChanged: (m) => setState(() => _moment = m ?? 'other'),
+          ),
+          const SizedBox(height: 12),
+          Text(i18n.physioPainScale),
+          Wrap(
+            spacing: 4,
+            children: [
+              for (var v = 0; v <= 10; v++)
+                ChoiceChip(
+                  label: Text('$v'),
+                  selected: _value == v,
+                  onSelected: (_) => setState(() => _value = v),
+                ),
+            ],
+          ),
+          TextFormField(
+            decoration: InputDecoration(labelText: i18n.physioPainRegion),
+            maxLength: 50,
+            onSaved: (v) => _region = v ?? '',
+          ),
+          TextFormField(
+            decoration: InputDecoration(labelText: i18n.physioPainNotes),
+            maxLength: 500,
+            onSaved: (v) => _notes = v ?? '',
+          ),
+          FilledButton(
+            onPressed: _saving ? null : _save,
+            child: Text(i18n.physioPainRecord),
+          ),
+          if (widget.day.pain.isNotEmpty) ...[
+            const Divider(),
+            for (final entry in widget.day.pain)
+              ListTile(
+                dense: true,
+                title: Text(painMomentLabel(i18n, entry.moment)),
+                trailing: Text('${entry.value}/10'),
+              ),
+          ],
+        ],
+      ),
+    );
+  }
+}
