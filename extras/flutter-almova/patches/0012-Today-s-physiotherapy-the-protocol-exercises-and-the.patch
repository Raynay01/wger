+
+import 'physio_today_screen_test.mocks.dart';
+
+const day = PhysioDay(
+  protocols: [
+    PhysioProtocolDay(
+      id: 'p1',
+      name: 'Reabilitação do joelho',
+      painMoments: ['after'],
+      exercises: [
+        PhysioExercise(
+          id: 'e1',
+          name: 'Ponte',
+          sets: 3,
+          repetitions: 1,
+          load: 'faixa vermelha',
+          location: 'home',
+          instructions: 'Suba devagar',
+        ),
+      ],
+    ),
+  ],
+);
+
+@GenerateMocks([PhysioRepository])
+void main() {
+  late MockPhysioRepository repository;
+
+  setUp(() {
+    repository = MockPhysioRepository();
+    when(repository.fetchToday()).thenAnswer((_) async => day);
+  });
+
+  Future<void> render(WidgetTester tester) async {
+    tester.view.physicalSize = const Size(1080, 3000);
+    tester.view.devicePixelRatio = 1;
+    addTearDown(tester.view.reset);
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [physioRepositoryProvider.overrideWithValue(repository)],
+        child: const MaterialApp(
+          locale: Locale('pt', 'BR'),
+          localizationsDelegates: appLocalizationsDelegates,
+          supportedLocales: AppLocalizations.supportedLocales,
+          home: PhysioTodayScreen(),
+        ),
+      ),
+    );
+    await tester.pumpAndSettle();
+  }
+
+  testWidgets('shows the exercise and marks it done', (tester) async {
+    when(repository.markDone('e1')).thenAnswer((_) async {});
+    await render(tester);
+
+    expect(find.text('Reabilitação do joelho'), findsOneWidget);
+    expect(find.text('3 séries · 1 repetição · faixa vermelha'), findsOneWidget);
+    expect(find.text('Em casa'), findsOneWidget);
+    expect(find.text('Suba devagar'), findsOneWidget);
+
+    await tester.tap(find.text('Marcar como feito'));
+    await tester.pumpAndSettle();
+
+    verify(repository.markDone('e1')).called(1);
+    expect(find.text('Feito hoje'), findsOneWidget);
+    expect(find.text('Marcar como feito'), findsNothing);
+  });
+
+  testWidgets('records the pain at a moment the physiotherapist asks for', (tester) async {
+    when(
+      repository.recordPain(
+        protocolId: anyNamed('protocolId'),
+        moment: anyNamed('moment'),
+        value: anyNamed('value'),
+        bodyRegion: anyNamed('bodyRegion'),
+        notes: anyNamed('notes'),
+      ),
+    ).thenAnswer((_) async {});
+    await render(tester);
+
+    // Without a value nothing is sent
+    await tester.tap(find.text('Registrar dor'));
+    await tester.pumpAndSettle();
+    expect(find.text('Escolha a intensidade de 0 a 10.'), findsOneWidget);
+
+    expect(find.text('Depois dos exercícios'), findsOneWidget);
+    await tester.tap(find.widgetWithText(ChoiceChip, '7'));
+    await tester.enterText(
+      find.widgetWithText(TextFormField, 'Local da dor (opcional)'),
+      ' joelho ',
+    );
+    await tester.tap(find.text('Registrar dor'));
+    await tester.pumpAndSettle();
+
+    verify(
+      repository.recordPain(
+        protocolId: 'p1',
+        moment: 'after',
+        value: 7,
+        bodyRegion: 'joelho',
+        notes: '',
+      ),
+    ).called(1);
+    expect(find.text('7/10'), findsOneWidget);
+    expect(find.text('Dor registrada.'), findsOneWidget);
+  });
+
+  testWidgets('without a protocol it says so and still takes the pain', (tester) async {
+    when(repository.fetchToday()).thenAnswer((_) async => const PhysioDay());
+    await render(tester);
+
+    expect(find.text('Nenhum protocolo de fisioterapia para hoje.'), findsOneWidget);
+    expect(find.text('Outro momento'), findsOneWidget);
+  });
+}
