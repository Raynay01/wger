+import 'package:riverpod_annotation/riverpod_annotation.dart';
+import 'package:wger/features/physio/models/physio_day.dart';
+import 'package:wger/features/physio/providers/physio_repository.dart';
+
+part 'physio_today_notifier.g.dart';
+
+@riverpod
+class PhysioTodayNotifier extends _$PhysioTodayNotifier {
+  @override
+  Future<PhysioDay> build() => ref.read(physioRepositoryProvider).fetchToday();
+
+  Future<void> markDone(String exerciseId) async {
+    await ref.read(physioRepositoryProvider).markDone(exerciseId);
+    final day = state.value;
+    if (day == null) {
+      return;
+    }
+    state = AsyncData(
+      PhysioDay(
+        pain: day.pain,
+        protocols: [
+          for (final protocol in day.protocols)
+            PhysioProtocolDay(
+              id: protocol.id,
+              name: protocol.name,
+              painMoments: protocol.painMoments,
+              exercises: [
+                for (final e in protocol.exercises)
+                  if (e.id == exerciseId) e.markedDone() else e,
+              ],
+            ),
+        ],
+      ),
+    );
+  }
+
+  Future<void> recordPain({
+    String? protocolId,
+    required String moment,
+    required int value,
+    String bodyRegion = '',
+    String notes = '',
+  }) async {
+    await ref
+        .read(physioRepositoryProvider)
+        .recordPain(
+          protocolId: protocolId,
+          moment: moment,
+          value: value,
+          bodyRegion: bodyRegion,
+          notes: notes,
+        );
+    final day = state.value;
+    state = AsyncData(
+      PhysioDay(
+        protocols: day?.protocols ?? const [],
+        pain: [
+          ...?day?.pain,
+          PainEntry(moment: moment, value: value, datetime: DateTime.now()),
+        ],
+      ),
+    );
+  }
+}
