+import 'dart:convert';
+
+import 'package:riverpod_annotation/riverpod_annotation.dart';
+import 'package:wger/core/exceptions/http_exception.dart';
+import 'package:wger/core/network/base_provider.dart';
+import 'package:wger/core/network/wger_base.dart';
+import 'package:wger/features/physio/models/physio_day.dart';
+
+part 'physio_repository.g.dart';
+
+@riverpod
+PhysioRepository physioRepository(Ref ref) => PhysioRepository(ref.read(wgerBaseProvider));
+
+/// REST access to the physiotherapy of the user (Django app `physio`)
+class PhysioRepository {
+  final WgerBaseProvider base;
+
+  PhysioRepository(this.base);
+
+  /// Today's protocols and pain records, in the user's time zone
+  Future<PhysioDay> fetchToday() async {
+    final data = await base.fetch(base.makeUrl('care/my-day'));
+    final physio = data['physio'];
+    return physio is Map<String, dynamic> ? PhysioDay.fromJson(physio) : const PhysioDay();
+  }
+
+  Future<void> markDone(String protocolExerciseId) =>
+      _post('exercise-record', {'protocol_exercise': protocolExerciseId});
+
+  /// Pain on the numeric scale, 0 (none) to 10 (worst imaginable)
+  Future<void> recordPain({
+    String? protocolId,
+    required String moment,
+    required int value,
+    String bodyRegion = '',
+    String notes = '',
+  }) => _post('pain-record', {
+    'protocol': protocolId,
+    'moment': moment,
+    'value': value,
+    'body_region': bodyRegion,
+    'notes': notes,
+  });
+
+  Future<void> _post(String path, Map<String, dynamic> body) async {
+    final response = await base.client.post(
+      base.makeUrl(path),
+      headers: base.getDefaultHeaders(),
+      body: json.encode(body),
+    );
+    if (response.statusCode >= 400) {
+      throw WgerHttpException(response);
+    }
+  }
+}
