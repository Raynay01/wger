+import 'dart:convert';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:wger/core/network/base_provider.dart';
+import 'package:wger/features/physio/providers/physio_repository.dart';
+
+void main() {
+  late List<http.Request> sent;
+
+  PhysioRepository answering(Map<String, dynamic> body) {
+    sent = [];
+    return PhysioRepository(
+      WgerBaseProvider(
+        serverUrl: 'https://almova.test',
+        client: MockClient((request) async {
+          sent.add(request);
+          return http.Response.bytes(
+            utf8.encode(json.encode(body)),
+            200,
+            headers: {'content-type': 'application/json'},
+          );
+        }),
+      ),
+    );
+  }
+
+  test("today's protocols and pain from the day of the user", () async {
+    final repository = answering({
+      'date': '2026-11-16',
+      'physio': {
+        'protocols': [
+          {
+            'id': 'p1',
+            'name': 'Joelho',
+            'pain_moments': ['before', 'after'],
+            'exercises': [
+              {
+                'id': 'e1',
+                'name': 'Ponte',
+                'sets': 3,
+                'repetitions': 12,
+                'duration_seconds': null,
+                'load': 'faixa vermelha',
+                'location': 'home',
+                'video_url': '',
+                'instructions': 'Devagar',
+                'done': true,
+              },
+            ],
+          },
+        ],
+        'pain': [
+          {
+            'moment': 'before',
+            'value': 4,
+            'datetime': '2026-11-16T10:00:00-03:00',
+            'protocol': 'p1',
+          },
+        ],
+      },
+    });
+
+    final day = await repository.fetchToday();
+
+    expect(sent.single.url.path, '/api/v2/care/my-day/');
+    expect(day.protocols.single.painMoments, ['before', 'after']);
+    expect(day.protocols.single.exercises.single.done, isTrue);
+    expect(day.protocols.single.exercises.single.load, 'faixa vermelha');
+    expect(day.pain.single.value, 4);
+  });
+
+  test('without physiotherapy the day is empty', () async {
+    final day = await answering({'date': '2026-11-16', 'physio': null}).fetchToday();
+
+    expect(day.protocols, isEmpty);
+    expect(day.pain, isEmpty);
+  });
+
+  test('marking done and recording pain', () async {
+    final repository = answering({});
+
+    await repository.markDone('e1');
+    await repository.recordPain(protocolId: 'p1', moment: 'after', value: 7, bodyRegion: 'joelho');
+
+    expect(sent[0].url.path, '/api/v2/exercise-record/');
+    expect(json.decode(sent[0].body), {'protocol_exercise': 'e1'});
+    expect(sent[1].url.path, '/api/v2/pain-record/');
+    expect(json.decode(sent[1].body), {
+      'protocol': 'p1',
+      'moment': 'after',
+      'value': 7,
+      'body_region': 'joelho',
+      'notes': '',
+    });
+  });
+}
