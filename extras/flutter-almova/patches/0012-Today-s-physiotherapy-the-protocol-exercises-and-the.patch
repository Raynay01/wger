+import 'package:json_annotation/json_annotation.dart';
+import 'package:wger/core/json.dart';
+
+part 'physio_day.g.dart';
+
+/// An exercise of a physiotherapy protocol, as prescribed for the day
+@JsonSerializable(createToJson: false)
+class PhysioExercise {
+  @JsonKey(required: true)
+  final String id;
+
+  @JsonKey(required: true)
+  final String name;
+
+  final int? sets;
+  final int? repetitions;
+
+  @JsonKey(name: 'duration_seconds')
+  final int? durationSeconds;
+
+  /// E.g. "red elastic band"
+  @JsonKey(defaultValue: '')
+  final String load;
+
+  /// home, gym or clinic
+  @JsonKey(defaultValue: '')
+  final String location;
+
+  @JsonKey(name: 'video_url', defaultValue: '')
+  final String videoUrl;
+
+  @JsonKey(defaultValue: '')
+  final String instructions;
+
+  /// Recorded as done on this day
+  @JsonKey(defaultValue: false)
+  final bool done;
+
+  const PhysioExercise({
+    required this.id,
+    required this.name,
+    this.sets,
+    this.repetitions,
+    this.durationSeconds,
+    this.load = '',
+    this.location = '',
+    this.videoUrl = '',
+    this.instructions = '',
+    this.done = false,
+  });
+
+  PhysioExercise markedDone() => PhysioExercise(
+    id: id,
+    name: name,
+    sets: sets,
+    repetitions: repetitions,
+    durationSeconds: durationSeconds,
+    load: load,
+    location: location,
+    videoUrl: videoUrl,
+    instructions: instructions,
+    done: true,
+  );
+
+  factory PhysioExercise.fromJson(Map<String, dynamic> json) => _$PhysioExerciseFromJson(json);
+}
+
+@JsonSerializable(createToJson: false)
+class PhysioProtocolDay {
+  @JsonKey(required: true)
+  final String id;
+
+  @JsonKey(required: true)
+  final String name;
+
+  /// Moments the physiotherapist asks the pain for: before, during, after, next_day
+  @JsonKey(name: 'pain_moments', defaultValue: <String>[])
+  final List<String> painMoments;
+
+  @JsonKey(defaultValue: <PhysioExercise>[])
+  final List<PhysioExercise> exercises;
+
+  const PhysioProtocolDay({
+    required this.id,
+    required this.name,
+    this.painMoments = const [],
+    this.exercises = const [],
+  });
+
+  factory PhysioProtocolDay.fromJson(Map<String, dynamic> json) =>
+      _$PhysioProtocolDayFromJson(json);
+}
+
+@JsonSerializable(createToJson: false)
+class PainEntry {
+  @JsonKey(required: true)
+  final String moment;
+
+  @JsonKey(required: true)
+  final int value;
+
+  @JsonKey(required: true, fromJson: utcIso8601ToLocalDate)
+  final DateTime datetime;
+
+  const PainEntry({required this.moment, required this.value, required this.datetime});
+
+  factory PainEntry.fromJson(Map<String, dynamic> json) => _$PainEntryFromJson(json);
+}
+
+/// The physiotherapy part of the user's day (care/my-day, section physio)
+@JsonSerializable(createToJson: false)
+class PhysioDay {
+  @JsonKey(defaultValue: <PhysioProtocolDay>[])
+  final List<PhysioProtocolDay> protocols;
+
+  @JsonKey(defaultValue: <PainEntry>[])
+  final List<PainEntry> pain;
+
+  const PhysioDay({this.protocols = const [], this.pain = const []});
+
+  factory PhysioDay.fromJson(Map<String, dynamic> json) => _$PhysioDayFromJson(json);
+}
