+import 'agenda_notifier_test.mocks.dart';
+
+const physio = CareRelationship(
+  id: 'r1',
+  discipline: Discipline.physio,
+  status: 'active',
+  professionalName: 'Paula',
+);
+
+Appointment appointment(String id, String relationship) => Appointment(
+  id: id,
+  relationship: relationship,
+  kind: 'session',
+  start: DateTime.utc(2026, 11, 18, 17),
+  durationMinutes: 50,
+  location: '',
+  status: 'scheduled',
+  discipline: Discipline.physio,
+  professional: 'Paula',
+);
+
+@GenerateMocks([CareRepository])
+void main() {
+  late MockCareRepository repository;
+  late ProviderContainer container;
+
+  setUp(() {
+    repository = MockCareRepository();
+    container = ProviderContainer(
+      overrides: [
+        careRepositoryProvider.overrideWithValue(repository),
+        networkStatusProvider.overrideWithValue(true),
+      ],
+    );
+    addTearDown(container.dispose);
+    when(repository.fetchMyProfessionals()).thenAnswer((_) async => [physio]);
+    when(repository.fetchUpcomingAppointments(any)).thenAnswer(
+      (_) async => [
+        appointment('a0', 'my-own-patient'),
+        appointment('a1', 'r1'),
+        appointment('a2', 'r1'),
+      ],
+    );
+  });
+
+  test('only the appointments of the user as patient', () async {
+    final agenda = await container.read(agendaProvider.future);
+
+    expect(agenda.map((a) => a.id), ['a1', 'a2']);
