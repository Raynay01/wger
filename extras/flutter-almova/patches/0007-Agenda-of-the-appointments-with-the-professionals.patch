+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:intl/intl.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:wger/core/widgets/progress_indicator.dart';
+import 'package:wger/features/care/care.dart';
+import 'package:wger/features/care/models/appointment.dart';
+import 'package:wger/features/care/providers/agenda_notifier.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+
+/// The user's upcoming appointments with their professionals
+class AgendaScreen extends ConsumerWidget {
+  const AgendaScreen({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    final agenda = ref.watch(agendaProvider);
+
+    return Scaffold(
+      appBar: AppBar(title: Text(i18n.careUpcomingAppointments)),
+      body: switch (agenda) {
+        AsyncValue(:final value?) when value.isEmpty => Center(
+          child: Text(i18n.careNoAppointments),
+        ),
+        AsyncValue(:final value?) => ListView.separated(
+          itemCount: value.length,
+          separatorBuilder: (_, _) => const Divider(height: 1),
+          itemBuilder: (context, index) => AppointmentTile(value[index]),
+        ),
+        AsyncValue(:final error?) => Center(child: Text(error.toString())),
+        _ => const CenteredProgressIndicator(),
+      },
+    );
+  }
+}
+
+class AppointmentTile extends ConsumerWidget {
+  final Appointment appointment;
+
+  const AppointmentTile(this.appointment, {super.key});
+
+  Future<void> _cancel(BuildContext context, WidgetRef ref) async {
+    final i18n = AppLocalizations.of(context);
+    final confirmed = await showDialog<bool>(
+      context: context,
+      builder: (context) => AlertDialog(
+        content: Text(i18n.careCancelAppointmentQuestion),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(false),
+            child: Text(MaterialLocalizations.of(context).closeButtonLabel),
+          ),
+          FilledButton(
+            onPressed: () => Navigator.of(context).pop(true),
+            child: Text(i18n.careCancelAppointment),
+          ),
+        ],
+      ),
+    );
+    if (confirmed != true) {
+      return;
+    }
+    try {
+      await ref.read(agendaProvider.notifier).cancel(appointment.id);
+    } catch (_) {
+      if (context.mounted) {
+        ScaffoldMessenger.of(
+          context,
+        ).showSnackBar(SnackBar(content: Text(i18n.careCancelFailed)));
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final i18n = AppLocalizations.of(context);
+    final locale = Localizations.localeOf(context).toString();
+    final when = DateFormat.MMMEd(locale).add_Hm().format(appointment.start);
+    final details = [
+      appointment.professional,
+      disciplineLabel(i18n, appointment.discipline),
+      '${appointment.durationMinutes} min',
+      if (appointment.location.isNotEmpty) appointment.location,
+    ].where((part) => part.isNotEmpty).join(' · ');
+
+    return ListTile(
+      leading: Icon(disciplineIcon(appointment.discipline)),
+      title: Text('$when · ${appointmentKindLabel(i18n, appointment.kind)}'),
+      subtitle: Text(appointment.notes.isEmpty ? details : '$details\n${appointment.notes}'),
+      isThreeLine: appointment.notes.isNotEmpty,
+      trailing: TextButton(
+        onPressed: () => _cancel(context, ref),
+        child: Text(i18n.careCancelAppointment),
+      ),
+    );
+  }
+}
