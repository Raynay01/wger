+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:mockito/annotations.dart';
+import 'package:mockito/mockito.dart';
+import 'package:wger/core/network/network_provider.dart';
+import 'package:wger/features/care/models/appointment.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+import 'package:wger/features/care/screens/agenda_screen.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+import 'package:wger/l10n/localizations_delegates.dart';
+
+import 'agenda_screen_test.mocks.dart';
+
+@GenerateMocks([CareRepository])
+void main() {
+  late MockCareRepository repository;
+
+  setUp(() {
+    repository = MockCareRepository();
+    when(repository.fetchMyProfessionals()).thenAnswer(
+      (_) async => [
+        const CareRelationship(
+          id: 'r1',
+          discipline: Discipline.physio,
+          status: 'active',
+          professionalName: 'Paula',
+        ),
+      ],
+    );
+  });
+
+  Widget render() => ProviderScope(
+    overrides: [
+      careRepositoryProvider.overrideWithValue(repository),
+      networkStatusProvider.overrideWithValue(true),
+    ],
+    child: const MaterialApp(
+      locale: Locale('pt', 'BR'),
+      localizationsDelegates: appLocalizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      home: AgendaScreen(),
+    ),
+  );
+
+  testWidgets('lists the appointment and cancels it after confirming', (tester) async {
+    when(repository.fetchUpcomingAppointments(any)).thenAnswer(
+      (_) async => [
+        Appointment(
+          id: 'a1',
+          relationship: 'r1',
+          kind: 'assessment',
+          start: DateTime(2026, 11, 18, 14, 30),
+          durationMinutes: 50,
+          location: 'Clínica Movimento',
+          notes: 'Traga o exame',
+          status: 'scheduled',
+          discipline: Discipline.physio,
+          professional: 'Paula',
+        ),
+      ],
+    );
+    when(repository.cancelAppointment('a1')).thenAnswer((_) async {});
+
+    await tester.pumpWidget(render());
+    await tester.pumpAndSettle();
+
+    expect(find.textContaining('14:30 · Avaliação'), findsOneWidget);
+    expect(
+      find.textContaining('Paula · Fisioterapia · 50 min · Clínica Movimento'),
+      findsOneWidget,
+    );
+    expect(find.textContaining('Traga o exame'), findsOneWidget);
+
+    // Closing the question keeps it
+    await tester.tap(find.text('Cancelar atendimento'));
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Fechar'));
+    await tester.pumpAndSettle();
+    verifyNever(repository.cancelAppointment(any));
+
+    await tester.tap(find.text('Cancelar atendimento'));
+    await tester.pumpAndSettle();
+    await tester.tap(find.widgetWithText(FilledButton, 'Cancelar atendimento'));
+    await tester.pumpAndSettle();
+
+    verify(repository.cancelAppointment('a1')).called(1);
+    expect(find.text('Nenhuma consulta marcada'), findsOneWidget);
+  });
+}
