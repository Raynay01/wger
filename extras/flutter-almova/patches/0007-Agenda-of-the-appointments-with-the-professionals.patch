+import 'package:riverpod_annotation/riverpod_annotation.dart';
+import 'package:wger/features/care/models/appointment.dart';
+import 'package:wger/features/care/providers/care_overview.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+
+part 'agenda_notifier.g.dart';
+
+/// The user's scheduled appointments as a patient, earliest first
+@riverpod
+class AgendaNotifier extends _$AgendaNotifier {
+  @override
+  Future<List<Appointment>> build() async {
+    final repository = ref.read(careRepositoryProvider);
+    final mine = (await repository.fetchMyProfessionals()).map((r) => r.id).toSet();
+    final upcoming = await repository.fetchUpcomingAppointments(DateTime.now());
+    return upcoming.where((a) => mine.contains(a.relationship)).toList();
+  }
+
+  Future<void> cancel(String id) async {
+    await ref.read(careRepositoryProvider).cancelAppointment(id);
+    state = AsyncData([...?state.value?.where((a) => a.id != id)]);
+    ref.invalidate(careOverviewProvider);
+  }
+}
