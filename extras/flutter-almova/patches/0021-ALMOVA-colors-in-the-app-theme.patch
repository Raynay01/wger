diff --git a/test/theme/theme_test.dart b/test/theme/theme_test.dart
index 72ef4b8..f8c80b4 100644
--- a/test/theme/theme_test.dart
+++ b/test/theme/theme_test.dart
@@ -21,7 +21,39 @@ import 'package:flutter_test/flutter_test.dart';
 import 'package:material_ui/material_ui.dart';
 import 'package:wger/theme/theme.dart';
 
+double _contrast(Color a, Color b) {
+  final values = [a.computeLuminance(), b.computeLuminance()]..sort();
+
+  return (values.last + 0.05) / (values.first + 0.05);
+}
+
 void main() {
+  group('ALMOVA colors', () {
+    test('the navy of the brand is the primary color of the light theme', () {
+      expect(wgerLightTheme.colorScheme.primary, const Color(0xff0b1f3a));
+    });
+
+    test('the green accent stays green, and readable as text on the background', () {
+      // The app writes some labels in the secondary color: the pure neon of
+      // the brand would be barely visible on white
+      for (final theme in [wgerLightTheme, wgerDarkTheme]) {
+        final scheme = theme.colorScheme;
+
+        expect(
+          Hct.fromInt(scheme.secondary.toARGB32()).hue,
+          closeTo(Hct.fromInt(wgerSecondaryColor.toARGB32()).hue, 15),
+        );
+        for (final color in [scheme.primary, scheme.secondary]) {
+          expect(
+            _contrast(color, scheme.surface),
+            greaterThanOrEqualTo(4.5),
+            reason: '$color on ${scheme.surface} in ${scheme.brightness}',
+          );
+        }
+      }
+    });
+  });
+
   group('wgerThemeFromSeed', () {
     const seed = Color(0xFF6750A4);
 
