+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:mockito/annotations.dart';
+import 'package:mockito/mockito.dart';
+import 'package:wger/core/network/network_provider.dart';
+import 'package:wger/core/widgets/dashboard/widgets/care.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+import 'package:wger/l10n/localizations_delegates.dart';
+
+import 'invitation_tile_test.mocks.dart';
+
+const invitation = CareRelationship(
+  id: 'r9',
+  discipline: Discipline.physio,
+  status: 'invited',
+  professionalName: 'Paula',
+  organizationName: 'Clínica Movimento',
+);
+
+@GenerateMocks([CareRepository])
+void main() {
+  late MockCareRepository repository;
+
+  setUp(() {
+    repository = MockCareRepository();
+    when(repository.fetchMyProfessionals()).thenAnswer((_) async => []);
+    when(repository.fetchInvitations()).thenAnswer((_) async => [invitation]);
+    when(repository.fetchUpcomingAppointments(any)).thenAnswer((_) async => []);
+  });
+
+  Widget render() => ProviderScope(
+    overrides: [
+      careRepositoryProvider.overrideWithValue(repository),
+      networkStatusProvider.overrideWithValue(true),
+    ],
+    child: const MaterialApp(
+      locale: Locale('pt', 'BR'),
+      localizationsDelegates: appLocalizationsDelegates,
+      supportedLocales: AppLocalizations.supportedLocales,
+      home: Scaffold(body: SingleChildScrollView(child: DashboardCareWidget())),
+    ),
+  );
+
+  testWidgets('the invitation says what accepting authorizes', (tester) async {
+    await tester.pumpWidget(render());
+    await tester.pumpAndSettle();
+
+    expect(find.text('Convites'), findsOneWidget);
+    expect(find.text('Paula'), findsOneWidget);
+    expect(find.text('Fisioterapeuta · Clínica Movimento'), findsOneWidget);
+    expect(
+      find.textContaining('acompanhar a sua parte de fisioterapia e a ver o que você registrar'),
+      findsOneWidget,
+    );
+  });
+
+  testWidgets('accepting tells the server and reloads the card', (tester) async {
+    when(repository.acceptInvitation('r9')).thenAnswer((_) async {});
+
+    await tester.pumpWidget(render());
+    await tester.pumpAndSettle();
+    when(repository.fetchInvitations()).thenAnswer((_) async => []);
+    when(repository.fetchMyProfessionals()).thenAnswer(
+      (_) async => [
+        const CareRelationship(
+          id: 'r9',
+          discipline: Discipline.physio,
+          status: 'active',
+          professionalName: 'Paula',
+        ),
+      ],
+    );
+    await tester.tap(find.text('Aceitar e autorizar'));
+    await tester.pumpAndSettle();
+
+    verify(repository.acceptInvitation('r9')).called(1);
+    expect(find.text('Convites'), findsNothing);
+    expect(find.text('Fisioterapia'), findsOneWidget);
+  });
+
+  testWidgets('declining', (tester) async {
+    when(repository.declineInvitation('r9')).thenAnswer((_) async {});
+
+    await tester.pumpWidget(render());
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Recusar'));
+    await tester.pumpAndSettle();
+
+    verify(repository.declineInvitation('r9')).called(1);
+    verifyNever(repository.acceptInvitation(any));
+  });
+
+  testWidgets('a failed answer says so', (tester) async {
+    when(repository.acceptInvitation('r9')).thenThrow(Exception('offline'));
+
+    await tester.pumpWidget(render());
+    await tester.pumpAndSettle();
+    await tester.tap(find.text('Aceitar e autorizar'));
+    await tester.pumpAndSettle();
+
+    expect(find.text('Não foi possível responder ao convite. Tente de novo.'), findsOneWidget);
+  });
+}
