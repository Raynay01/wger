+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:wger/features/care/care.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/providers/care_overview.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+
+/// An invitation of a professional: what accepting authorizes, accept or decline
+class InvitationTile extends ConsumerStatefulWidget {
+  final CareRelationship invitation;
+
+  const InvitationTile(this.invitation, {super.key});
+
+  @override
+  ConsumerState<InvitationTile> createState() => _InvitationTileState();
+}
+
+class _InvitationTileState extends ConsumerState<InvitationTile> {
+  bool _busy = false;
+
+  Future<void> _answer(bool accept) async {
+    final i18n = AppLocalizations.of(context);
+    final repository = ref.read(careRepositoryProvider);
+    setState(() => _busy = true);
+    try {
+      if (accept) {
+        await repository.acceptInvitation(widget.invitation.id);
+      } else {
+        await repository.declineInvitation(widget.invitation.id);
+      }
+      ref.invalidate(careOverviewProvider);
+    } catch (_) {
+      if (mounted) {
+        ScaffoldMessenger.of(
+          context,
+        ).showSnackBar(SnackBar(content: Text(i18n.careInvitationFailed)));
+      }
+    } finally {
+      if (mounted) {
+        setState(() => _busy = false);
+      }
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final i18n = AppLocalizations.of(context);
+    final invitation = widget.invitation;
+    final where = [
+      professionLabel(i18n, invitation.discipline),
+      ?invitation.organizationName,
+    ].where((part) => part.isNotEmpty).join(' · ');
+
+    return Padding(
+      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(invitation.professionalName, style: Theme.of(context).textTheme.titleMedium),
+          Text(where, style: Theme.of(context).textTheme.bodySmall),
+          const SizedBox(height: 8),
+          Text(
+            i18n.careInvitationConsent(
+              disciplineLabel(i18n, invitation.discipline).toLowerCase(),
+            ),
+          ),
+          const SizedBox(height: 8),
+          Wrap(
+            spacing: 8,
+            children: [
+              FilledButton(
+                onPressed: _busy ? null : () => _answer(true),
+                child: Text(i18n.careInvitationAccept),
+              ),
+              OutlinedButton(
+                onPressed: _busy ? null : () => _answer(false),
+                child: Text(i18n.careInvitationDecline),
+              ),
+            ],
+          ),
+        ],
+      ),
+    );
+  }
+}
