+ */
+
+import 'dart:async';
+
+import 'package:material_ui/material_ui.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+import 'package:wger/features/care/screens/agenda_screen.dart';
+import 'package:wger/features/care/screens/conversation_screen.dart';
+
+/// Opens the screen of a tapped notice. The paths are those of the web app:
+/// `/app/mensagens/{follow-up}` and `/app/agenda`; for the others (e.g. a new
+/// plan, /app) the dashboard the app opens on already shows what is new.
+/// Returns once the screen is pushed, not when it is closed.
+Future<void> openNoticePath(
+  NavigatorState navigator,
+  CareRepository repository,
+  String path,
+) async {
+  final segments = Uri.parse(path).pathSegments;
+  if (segments.length < 2 || segments.first != 'app') {
+    return;
+  }
+  switch (segments[1]) {
+    case 'agenda':
+      unawaited(navigator.push(MaterialPageRoute(builder: (_) => const AgendaScreen())));
+    case 'mensagens' when segments.length > 2:
+      final relationship = (await repository.fetchMyProfessionals())
+          .where((r) => r.id == segments[2])
+          .firstOrNull;
+      if (relationship != null) {
+        unawaited(
+          navigator.push(
+            MaterialPageRoute(builder: (_) => ConversationScreen(relationship: relationship)),
+          ),
+        );
+      }
+  }
+}
diff --git a/lib/features/care/notifications/push_messaging.dart b/lib/features/care/notifications/push_messaging.dart
new file mode 100644
index 0000000..146fe31
--- /dev/null
+++ b/lib/features/care/notifications/push_messaging.dart
@@ -0,0 +1,111 @@
+/*
+ * This file is part of wger Workout Manager <https://github.com/wger-project>.
+ * Copyright (c) 2020 - 2026 wger Team
+ *
+ * wger Workout Manager is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Affero General Public License for more details.
+ *
+ * You should have received a copy of the GNU Affero General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+import 'package:firebase_core/firebase_core.dart';
+import 'package:firebase_messaging/firebase_messaging.dart';
+
+/// The Firebase project of the app, set when building it:
+/// `--dart-define=FCM_API_KEY=... --dart-define=FCM_APP_ID=...
+/// --dart-define=FCM_SENDER_ID=... --dart-define=FCM_PROJECT_ID=...`
+/// (Firebase console, project settings, the Android app). Empty: no push.
+const fcmApiKey = String.fromEnvironment('FCM_API_KEY');
+const fcmAppId = String.fromEnvironment('FCM_APP_ID');
+const fcmSenderId = String.fromEnvironment('FCM_SENDER_ID');
+const fcmProjectId = String.fromEnvironment('FCM_PROJECT_ID');
+
+bool get pushConfigured =>
+    fcmApiKey.isNotEmpty &&
+    fcmAppId.isNotEmpty &&
+    fcmSenderId.isNotEmpty &&
+    fcmProjectId.isNotEmpty;
+
+/// A notice shown while the app is open (the system shows the others)
+typedef ForegroundNotice = ({String title, String body});
+
+/// What the app needs from Firebase Cloud Messaging, replaceable in tests
+abstract class PushMessaging {
+  Future<void> initialize();
+
+  /// Asks the user (Android 13+, iOS); false when refused
+  Future<bool> requestPermission();
+
+  /// Tokens of this phone: the first after [register], then the renewed ones
+  Stream<String> get onRegistered;
+
+  Future<void> register();
+
+  /// Drops the token of this phone
+  Future<void> unregister();
+
+  /// The path of the notice that opened the app, if one did
+  Future<String?> initialPath();
+
+  /// Paths of notices tapped while the app runs in the background
+  Stream<String> get onOpenedPath;
+
+  Stream<ForegroundNotice> get onForeground;
+}
+
+class FirebasePushMessaging implements PushMessaging {
+  FirebaseMessaging get _messaging => FirebaseMessaging.instance;
+
+  @override
+  Future<void> initialize() async {
+    if (Firebase.apps.isEmpty) {
+      await Firebase.initializeApp(
+        options: const FirebaseOptions(
+          apiKey: fcmApiKey,
+          appId: fcmAppId,
+          messagingSenderId: fcmSenderId,
+          projectId: fcmProjectId,
+        ),
+      );
+    }
+  }
+
+  @override
+  Future<bool> requestPermission() async {
+    final settings = await _messaging.requestPermission();
+    return settings.authorizationStatus == AuthorizationStatus.authorized ||
+        settings.authorizationStatus == AuthorizationStatus.provisional;
+  }
+
+  @override
+  Stream<String> get onRegistered => _messaging.onRegistered;
+
+  @override
+  Future<void> register() => _messaging.register();
+
+  @override
+  Future<void> unregister() => _messaging.unregister();
+
+  @override
+  Future<String?> initialPath() async =>
+      (await _messaging.getInitialMessage())?.data['path'] as String?;
+
+  @override
+  Stream<String> get onOpenedPath => FirebaseMessaging.onMessageOpenedApp
+      .map((m) => m.data['path'] as String?)
+      .where((path) => path != null)
+      .cast<String>();
+
+  @override
+  Stream<ForegroundNotice> get onForeground => FirebaseMessaging.onMessage
+      .where((m) => m.notification != null)
+      .map((m) => (title: m.notification!.title ?? '', body: m.notification!.body ?? ''));
+}
diff --git a/lib/features/care/notifications/push_notifications.dart b/lib/features/care/notifications/push_notifications.dart
new file mode 100644
index 0000000..2e2f778
--- /dev/null
+++ b/lib/features/care/notifications/push_notifications.dart
@@ -0,0 +1,122 @@
+/*
+ * This file is part of wger Workout Manager <https://github.com/wger-project>.
+ * Copyright (c) 2020 - 2026 wger Team
+ *
+ * wger Workout Manager is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU Affero General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Affero General Public License for more details.
+ *
+ * You should have received a copy of the GNU Affero General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+import 'dart:async';
+import 'dart:io';
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:logging/logging.dart';
+import 'package:wger/features/care/notifications/push_messaging.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+
+final _logger = Logger('PushNotifications');
+
+/// Registers the phone for the notices of the server after the login and
+/// removes it at the logout, so the next person on the phone does not get
+/// them. Off unless the build has the Firebase project ([pushConfigured]).
+class PushNotifications {
+  final PushMessaging _messaging;
+  final CareRepository Function() _repository;
+  final bool enabled;
+  final String platform;
+
+  String? _token;
+  final _subscriptions = <StreamSubscription<Object?>>[];
+
+  PushNotifications(
+    this._messaging,
+    this._repository, {
+    required this.enabled,
+    required this.platform,
+  });
+
+  bool get started => _subscriptions.isNotEmpty;
+
+  /// [open] gets the path of a tapped notice (e.g. /app/agenda), [show] the
+  /// notices that arrive while the app is open
+  Future<void> start({
+    required void Function(String path) open,
+    required void Function(ForegroundNotice notice) show,
+  }) async {
+    if (!enabled || started) {
+      return;
+    }
+    try {
+      await _messaging.initialize();
+      if (!await _messaging.requestPermission()) {
+        _logger.info('Notices not allowed on this phone');
+        return;
+      }
+      _subscriptions
+        ..add(_messaging.onRegistered.listen(_register))
+        ..add(_messaging.onOpenedPath.listen(open))
+        ..add(_messaging.onForeground.listen(show));
+      await _messaging.register();
+      final initial = await _messaging.initialPath();
+      if (initial != null) {
+        open(initial);
+      }
+    } catch (e, s) {
+      // The app works without notices
+      _logger.warning('Could not start the notices', e, s);
+    }
+  }
+
+  Future<void> _register(String token) async {
+    _token = token;
+    try {
+      await _repository().registerPushDevice(token, platform);
+    } catch (e) {
+      _logger.warning('Could not register the phone for the notices', e);
+    }
+  }
+
+  /// At the logout, while the login still works
+  Future<void> stop() async {
+    for (final subscription in _subscriptions) {
+      await subscription.cancel();
+    }
+    _subscriptions.clear();
+    final token = _token;
+    _token = null;
+    if (token == null) {
+      return;
+    }
+    try {
+      await _repository().removePushDevice(token);
+    } catch (e) {
+      _logger.warning('Could not remove the phone from the notices', e);
+    }
+    try {
+      await _messaging.unregister();
+    } catch (e) {
+      _logger.warning('Could not delete the notice token', e);
+    }
+  }
+}
+
+final pushNotificationsProvider = Provider<PushNotifications>((ref) {
+  final mobile = !kIsWeb && (Platform.isAndroid || Platform.isIOS);
+  return PushNotifications(
+    FirebasePushMessaging(),
+    () => ref.read(careRepositoryProvider),
+    enabled: mobile && pushConfigured,
+    platform: !kIsWeb && Platform.isIOS ? 'ios' : 'android',
+  );
+});
