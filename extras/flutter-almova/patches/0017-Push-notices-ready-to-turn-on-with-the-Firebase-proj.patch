   }
+
+  /// Registers this phone for the push notices of the user (android or ios);
+  /// a token known for another user moves to this one
+  Future<void> registerPushDevice(String token, String platform) =>
+      _postAction('care/push-devices', {'token': token, 'platform': platform});
+
+  Future<void> removePushDevice(String token) =>
+      _postAction('care/push-devices/remove', {'token': token});
 }
