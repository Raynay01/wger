+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:material_ui/material_ui.dart';
+import 'package:mockito/annotations.dart';
+import 'package:mockito/mockito.dart';
+import 'package:wger/core/network/network_provider.dart';
+import 'package:wger/features/care/models/care_relationship.dart';
+import 'package:wger/features/care/notifications/open_notice.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+import 'package:wger/features/care/screens/agenda_screen.dart';
+import 'package:wger/features/care/screens/conversation_screen.dart';
+import 'package:wger/l10n/generated/app_localizations.dart';
+import 'package:wger/l10n/localizations_delegates.dart';
+
+import 'open_notice_test.mocks.dart';
+
+@GenerateMocks([CareRepository])
+void main() {
+  late MockCareRepository repository;
+  final navigatorKey = GlobalKey<NavigatorState>();
+
+  setUp(() {
+    repository = MockCareRepository();
+    when(repository.fetchMyProfessionals()).thenAnswer(
+      (_) async => [
+        const CareRelationship(
+          id: 'r1',
+          discipline: Discipline.physio,
+          status: 'active',
+          professionalName: 'Paula',
+        ),
+      ],
+    );
+    when(repository.fetchInvitations()).thenAnswer((_) async => []);
+    when(repository.fetchUpcomingAppointments(any)).thenAnswer((_) async => []);
+    when(repository.fetchMessages(any)).thenAnswer((_) async => []);
+  });
+
+  Future<void> open(WidgetTester tester, String path) async {
+    await tester.pumpWidget(
+      ProviderScope(
+        overrides: [
+          careRepositoryProvider.overrideWithValue(repository),
+          networkStatusProvider.overrideWithValue(true),
+        ],
+        child: MaterialApp(
+          navigatorKey: navigatorKey,
+          locale: const Locale('pt', 'BR'),
+          localizationsDelegates: appLocalizationsDelegates,
+          supportedLocales: AppLocalizations.supportedLocales,
+          home: const Scaffold(body: Text('Início')),
+        ),
+      ),
+    );
+    await openNoticePath(navigatorKey.currentState!, repository, path);
+    await tester.pumpAndSettle();
+  }
+
+  testWidgets('a notice about the agenda opens the agenda', (tester) async {
+    await open(tester, '/app/agenda');
+    expect(find.byType(AgendaScreen), findsOneWidget);
+  });
+
+  testWidgets('a notice about messages opens that conversation', (tester) async {
+    await open(tester, '/app/mensagens/r1');
+    expect(find.byType(ConversationScreen), findsOneWidget);
+    expect(find.text('Paula'), findsOneWidget);
+  });
+
+  testWidgets('other notices stay on the dashboard', (tester) async {
+    for (final path in ['/app', '/app/mensagens/desconhecido', '/pro/agenda']) {
+      await open(tester, path);
+      expect(find.text('Início'), findsOneWidget, reason: path);
+    }
+  });
+}
