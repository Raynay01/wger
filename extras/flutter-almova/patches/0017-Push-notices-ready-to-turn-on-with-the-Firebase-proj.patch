+
+import 'dart:async';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:mockito/annotations.dart';
+import 'package:mockito/mockito.dart';
+import 'package:wger/features/care/notifications/push_messaging.dart';
+import 'package:wger/features/care/notifications/push_notifications.dart';
+import 'package:wger/features/care/providers/care_repository.dart';
+
+import 'push_notifications_test.mocks.dart';
+
+/// Firebase Cloud Messaging as the app sees it, driven by the test
+class FakePushMessaging implements PushMessaging {
+  bool allowed = true;
+  String? initial;
+  final registered = StreamController<String>.broadcast();
+  final opened = StreamController<String>.broadcast();
+  final foreground = StreamController<ForegroundNotice>.broadcast();
+  int initializations = 0;
+  int unregistrations = 0;
+
+  @override
+  Future<void> initialize() async => initializations++;
+
+  @override
+  Future<bool> requestPermission() async => allowed;
+
+  @override
+  Stream<String> get onRegistered => registered.stream;
+
+  @override
+  Future<void> register() async => registered.add('token-1');
+
+  @override
+  Future<void> unregister() async => unregistrations++;
+
+  @override
+  Future<String?> initialPath() async => initial;
+
+  @override
+  Stream<String> get onOpenedPath => opened.stream;
+
+  @override
+  Stream<ForegroundNotice> get onForeground => foreground.stream;
+}
+
+@GenerateMocks([CareRepository])
+void main() {
+  late FakePushMessaging messaging;
+  late MockCareRepository repository;
+  late List<String> opened;
+  late List<ForegroundNotice> shown;
+
+  setUp(() {
+    messaging = FakePushMessaging();
+    repository = MockCareRepository();
+    when(repository.registerPushDevice(any, any)).thenAnswer((_) async {});
+    when(repository.removePushDevice(any)).thenAnswer((_) async {});
+    opened = [];
+    shown = [];
+  });
+
+  PushNotifications push({bool enabled = true}) =>
+      PushNotifications(messaging, () => repository, enabled: enabled, platform: 'android');
+
+  Future<void> start(PushNotifications notices) async {
+    await notices.start(open: opened.add, show: shown.add);
+    await pumpEventQueue();
+  }
+
+  test('off without the Firebase project in the build', () async {
+    await start(push(enabled: false));
+
+    expect(messaging.initializations, 0);
+    verifyZeroInteractions(repository);
+  });
+
+  test('nothing registered when the user refuses the notices', () async {
+    messaging.allowed = false;
+    await start(push());
+
+    verifyNever(repository.registerPushDevice(any, any));
+  });
+
+  test('registers the phone, also with a renewed token', () async {
+    await start(push());
+    messaging.registered.add('token-2');
+    await pumpEventQueue();
+
+    verifyInOrder([
+      repository.registerPushDevice('token-1', 'android'),
+      repository.registerPushDevice('token-2', 'android'),
+    ]);
+  });
+
+  test('a tapped notice opens its screen, one arriving in the app is shown', () async {
+    messaging.initial = '/app/agenda';
+    await start(push());
+    messaging.opened.add('/app/mensagens/r1');
+    messaging.foreground.add((title: 'ALMOVA: Mensagem nova', body: 'Abra o app'));
+    await pumpEventQueue();
+
+    expect(opened, ['/app/agenda', '/app/mensagens/r1']);
+    expect(shown.single.title, 'ALMOVA: Mensagem nova');
+  });
+
+  test('the logout removes the phone with its last token', () async {
+    final notices = push();
+    await start(notices);
+    messaging.registered.add('token-2');
+    await pumpEventQueue();
+
+    await notices.stop();
+    await notices.stop();
+
+    verify(repository.removePushDevice('token-2')).called(1);
+    expect(messaging.unregistrations, 1);
+    expect(notices.started, isFalse);
+  });
+
+  test('a failed registration does not break the app', () async {
+    when(repository.registerPushDevice('token-1', any)).thenThrow(Exception('offline'));
+    messaging.initial = '/app/agenda';
+    await start(push());
+
+    // The notices keep working and the next token is registered
+    messaging.registered.add('token-2');
+    await pumpEventQueue();
+    expect(opened, ['/app/agenda']);
+    verify(repository.registerPushDevice('token-2', 'android')).called(1);
+  });
+}
